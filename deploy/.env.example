# Copy to /opt/zagejmi/.env on the server and fill in. Never commit the real file.
# Generate each secret with:  openssl rand -hex 32
# (hex only: the database password goes into a connection string, where ; or = would break it.)

DOMAIN=zagejmi.cz

POSTGRES_PASSWORD=
MINIO_ROOT_USER=zagejmi
MINIO_ROOT_PASSWORD=

# Signs login tokens. Changing it signs everyone out.
JWT_KEY=
# Mixed into every password hash. Set once before the first user registers and NEVER change it,
# otherwise nobody can log in any more.
PASSWORD_PEPPER=

# SMTP relay for verification emails (Mailgun, Postmark, SendGrid, Amazon SES, Seznam, ...).
# Left empty, registration works but no email goes out.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USE_AUTHENTICATION=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@zagejmi.cz
SMTP_FROM_NAME=Zagejmi
