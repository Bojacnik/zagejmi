# Copy to /opt/zagejmi/.env on the server and fill in. Never commit the real file.
# Generate each secret with:  openssl rand -hex 32
# (hex only: the database password goes into a connection string, where ; or = would break it.)

DOMAIN=zagejmi.cz

POSTGRES_PASSWORD=
MINIO_ROOT_USER=zagejmi
MINIO_ROOT_PASSWORD=

# Signs login tokens. Changing it signs everyone out.
JWT_KEY=
# Mixed into every password hash. Set once before the first user registers and NEVER change it,
# otherwise nobody can log in any more.
PASSWORD_PEPPER=

# Where mail goes out: an SMTP relay (Brevo, Mailgun, Seznam, ...) or our own mail server. Left empty, registration works
# but no email goes out. The switch to our own server rewrites these lines: mail/switch-smtp.sh own|relay (deploy/MAIL.md).
# The Hetzner server blocks outgoing 25 and 465 until Hetzner unblocks them, so a relay has to be on 587.
SMTP_HOST=
SMTP_PORT=587
# Auto (465 = implicit TLS, otherwise STARTTLS), StartTls, SslOnConnect or None.
SMTP_SECURITY=Auto
SMTP_ENABLE_SSL=true
SMTP_USE_AUTHENTICATION=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@zagejmi.cz
SMTP_FROM_NAME=Zagejmi

# E-mail of the admin who decides reported orders on /admin/orders (must be a verified Zagejmi account).
# Empty = reported orders stay frozen until someone is set here.
ADMIN_EMAIL=

# Our own mail server (deploy/MAIL.md). mail/setup-mail.sh fills these in; leave them out until then.
# COMPOSE_PROFILES=mail starts the mail service with every deploy.
#COMPOSE_PROFILES=mail
#MAIL_HOSTNAME=mx.zagejmi.cz
#MAIL_ADMIN=admin:<generated>
#MAIL_NOREPLY_PASSWORD=<generated>
#MAIL_POSTMASTER_PASSWORD=<generated>
