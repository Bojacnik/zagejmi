# Copy to .env when running production stack:
# docker compose -f docker-compose.yaml -f docker-compose.prod.yaml up -d --build
# Do not commit real credentials.

ASPNETCORE_ENVIRONMENT=Production

# Public URL used in verification links sent by email
PUBLIC_BASE_URL=https://zagejmi.cz

# SMTP relay settings
# Example providers:
# - Mailgun: smtp.eu.mailgun.org
# - Postmark: smtp.postmarkapp.com
# - SendGrid: smtp.sendgrid.net
# - Amazon SES: email-smtp.<region>.amazonaws.com
SMTP_HOST=smtp.your-relay-provider.tld
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USE_AUTHENTICATION=true
SMTP_USERNAME=relay-username
SMTP_PASSWORD=relay-password
SMTP_FROM_EMAIL=no-reply@zagejmi.cz
SMTP_FROM_NAME=Zagejmi