<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <UserSecretsId>aspnet-Zagejmi-6d328d51-07da-47e4-b73f-4e7db672fcc7</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Zagejmi.Application\Zagejmi.Application.csproj"/>
        <ProjectReference Include="..\Zagejmi.Infrastructure\Zagejmi.Infrastructure.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets"/>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens"/>
        <PackageReference Include="Microsoft.IdentityModel.Tokens"/>
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen"/>
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI"/>
        <PackageReference Include="System.IdentityModel.Tokens.Jwt"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <!--
        Regenerate the Tailwind output before static web assets are fingerprinted and pre-compressed;
        otherwise MapStaticAssets keeps serving the stylesheet captured by the previous build.
        Skipped when node_modules is missing (e.g. the Docker SDK stage, which copies styles.css from its node stage).
    -->
    <ItemGroup>
        <TailwindInputs Include="wwwroot/app.css;**/*.razor;**/*.cshtml;**/*.html"
                        Exclude="bin/**;obj/**;node_modules/**"/>
    </ItemGroup>

    <Target Name="BuildTailwindCss"
            BeforeTargets="ResolveProjectStaticWebAssets"
            Condition="Exists('node_modules')"
            Inputs="@(TailwindInputs)"
            Outputs="wwwroot/styles.css">
        <Exec Command="npm run css:build" WorkingDirectory="$(MSBuildProjectDirectory)"/>
        <!-- Tailwind leaves the file untouched when its content is unchanged; bump it so the target stays incremental. -->
        <Touch Files="wwwroot/styles.css"/>
        <ItemGroup>
            <!-- Picks up styles.css on a fresh clone, where it did not exist when the project was evaluated. -->
            <Content Include="wwwroot/styles.css" Exclude="@(Content)"/>
        </ItemGroup>
    </Target>


</Project>