@page "/login"
@using Zagejmi.Application.Auth.Users.LoginUser
@using Zagejmi.Application.Auth.Users.ResendVerificationEmail
@using Zagejmi.Shared
@rendermode InteractiveServer
@inject NavigationManager NavManager
@inject LoginUserHandler LoginHandler
@inject ResendVerificationEmailHandler ResendVerificationHandler
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Přihlášení – Zagejmi</PageTitle>

<div class="w-full h-full flex flex-col justify-center items-center p-4">
    <form @onsubmit="HandleLoginAsync" @onsubmit:preventDefault novalidate
          class="w-full max-w-sm p-8 space-y-6 bg-primary-900 rounded-xl border border-accent-700/50 shadow-2xl shadow-accent-900/30">

        <header class="text-center">
            <h1 class="text-4xl font-bold text-gray-100">Vítejte zpět</h1>
            <p class="text-gray-400 mt-2">Přihlaste se svými údaji.</p>
        </header>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="p-4 text-sm text-red-400 bg-red-900/30 border border-red-400/50 rounded-lg" role="alert">
                <p>@ErrorMessage</p>
            </div>
        }

        @if (!string.IsNullOrEmpty(resendMessage))
        {
            <div class="p-4 text-sm text-green-400 bg-green-900/30 border border-green-400/50 rounded-lg" role="status">
                <p>@resendMessage</p>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(registeredMessage))
        {
            <div class="p-4 text-sm text-green-400 bg-green-900/30 border border-green-400/50 rounded-lg" role="status">
                <p>@registeredMessage</p>
            </div>
        }

        <div class="space-y-4">
            <div>
                <label for="useridentifier" class="sr-only">Uživatelské jméno nebo e-mail</label>
                <input @bind="userIdentifier" @bind:event="oninput" type="text" id="useridentifier"
                       placeholder="Uživatelské jméno nebo e-mail" required
                       class="w-full px-4 py-3 bg-gray-200 border-2 border-gray-300 rounded-lg text-black placeholder:text-gray-500 focus:ring-2 focus:ring-accent-500 focus:border-accent-500 outline-hidden transition-all"/>
            </div>

            <div>
                <label for="password" class="sr-only">Heslo</label>
                <input @bind="password" type="password" id="password" placeholder="Heslo" required
                       class="w-full px-4 py-3 bg-gray-200 border-2 border-gray-300 rounded-lg text-black placeholder:text-gray-500 focus:ring-2 focus:ring-accent-500 focus:border-accent-500 outline-hidden transition-all"/>
            </div>
        </div>

        <div class="flex flex-col gap-4 pt-4">
            <button type="submit"
                    disabled="@isSubmitting"
                    class="w-full px-4 py-3 font-bold text-lg text-white bg-accent-600 hover:bg-accent-700 rounded-lg transition-colors shadow-lg shadow-accent-800/40 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus:ring-offset-primary-900 focus:ring-accent-500 disabled:opacity-50 disabled:cursor-not-allowed">
                <span>@(isSubmitting ? "Přihlašujeme…" : "Přihlásit se")</span>
            </button>
            <button type="button"
                    @onclick="ResendVerificationEmail"
                    disabled="@(isResending || string.IsNullOrWhiteSpace(userIdentifier))"
                    class="w-full px-4 py-3 font-semibold text-white bg-primary-700 hover:bg-primary-600 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                @if (isResending)
                {
                    <span>Odesíláme ověřovací e-mail…</span>
                }
                else if (showResendVerification)
                {
                    <span>Znovu poslat ověřovací e-mail (účet není ověřený)</span>
                }
                else
                {
                    <span>Znovu poslat ověřovací e-mail</span>
                }
            </button>
            <div class="text-center">
                <a href="/register"
                   class="text-sm font-medium text-accent-400 hover:text-accent-300 hover:underline transition-colors">
                    Nemáte účet? Zaregistrujte se.
                </a>
            </div>
        </div>
    </form>
</div>

@code {

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "registered")]
    private int? Registered { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    private string? RegisteredEmail { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorMessage { get; set; }

    private string userIdentifier = string.Empty;
    private string password = string.Empty;
    private string normalizedReturnUrl = "/";
    private bool showResendVerification;
    private bool isResending;
    private bool isSubmitting;
    private string resendMessage = string.Empty;
    private string? registeredMessage;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl)
            && Uri.TryCreate(ReturnUrl, UriKind.Relative, out _)
            && ReturnUrl.StartsWith("/", StringComparison.Ordinal)
            && !ReturnUrl.StartsWith("//", StringComparison.Ordinal))
        {
            normalizedReturnUrl = ReturnUrl;
        }

        if (Registered != 1) return;

        registeredMessage = "Účet je vytvořený. Ověřte svůj e-mail a pak se přihlaste.";
        if (!string.IsNullOrWhiteSpace(RegisteredEmail))
        {
            userIdentifier = RegisteredEmail.Trim();
        }
    }

    private async Task ResendVerificationEmail()
    {
        if (isResending || string.IsNullOrWhiteSpace(userIdentifier))
        {
            return;
        }

        isResending = true;
        ErrorMessage = null;
        resendMessage = string.Empty;

        try
        {
            Result result = await ResendVerificationHandler.Handle(new ResendVerificationEmailCommand(userIdentifier));
            if (result.IsFailure)
            {
                ErrorMessage = result.Error!.Message;
                showResendVerification = result.Error.Code == LoginUserHandler.EmailNotVerified.Code;
                return;
            }

            // Deliberately the same text whether or not the account exists (see ResendVerificationEmailHandler).
            resendMessage = "Pokud účet existuje a ještě není ověřený, poslali jsme na jeho e-mail nový odkaz. "
                            + "Nový odkaz lze poslat nejdříve za minutu.";
        }
        finally
        {
            isResending = false;
        }
    }

    private async Task HandleLoginAsync()
    {
        if (isSubmitting)
        {
            return;
        }

        ErrorMessage = null;
        resendMessage = string.Empty;
        registeredMessage = null;
        showResendVerification = false;
        isSubmitting = true;

        try
        {
            Result<LoginUserResult> result = await LoginHandler.Handle(new LoginUserCommand
            {
                UserIdentifier = userIdentifier,
                Password = password,
            });

            if (result.IsFailure)
            {
                ErrorMessage = result.Error!.Message;
                return;
            }

            if (AuthenticationStateProvider is JwtAuthenticationStateProvider jwtProvider)
            {
                await jwtProvider.SetTokensAsync(result.Value.AccessToken, result.Value.RefreshToken);
            }

            NavManager.NavigateTo(normalizedReturnUrl, forceLoad: true);
        }
        finally
        {
            isSubmitting = false;
        }
    }

}