@page "/people"
@page "/players/{ProfileId:guid}"
@using System.Threading
@using Zagejmi.Application.Abstractions
@using Zagejmi.Application.Profiles
@using Zagejmi.Application.Profiles.SearchPlayers
@using Zagejmi.Shared
@rendermode InteractiveServer
@implements IDisposable

@inject SearchPlayersHandler SearchPlayersHandler
@inject NavigationManager NavigationManager

@*
    Player directory, most complete profiles first (pictures, services with images), then newest, with a name filter.
    Tabs (MARKET-002): Přehled shows two rows of Hráčky, Hráči and Ostatní; each group's tab (?gender=Women) and
    Všichni (?gender=All) show the full list.
    Clicking a card opens the player popup at /players/{id} (shareable; Back closes it) without leaving the page.
*@

<PageTitle>Hráči</PageTitle>

<div class="w-full">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div>
                <h1 class="text-4xl font-bold text-text-default">Najít hráče a hráčky</h1>
                <p class="text-text-muted mt-2">Procházejte hráče a hráčky v naší komunitě a spojte se s nimi</p>
            </div>
            <div class="relative w-full md:w-80">
                <label for="player-search" class="sr-only">Hledat podle přezdívky</label>
                <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-text-muted" fill="none"
                     stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15z"></path>
                </svg>
                <input id="player-search" type="search" placeholder="Hledat podle přezdívky…" autocomplete="off"
                       @bind="searchText" @bind:event="oninput" @bind:after="OnSearchChanged"
                       class="w-full pl-10 pr-4 py-2.5 rounded-full bg-primary-900/80 border border-accent-700/50 text-text-default placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-accent-500 transition-colors"/>
            </div>
        </div>

        <div class="mb-6">
            <DiscoveryTabs BasePath="/people" Active="@ActiveTab" Counts="@(sections.Counts.Count == 0 ? null : sections.Counts)"/>
        </div>

        @if (isLoading && sections.IsEmpty)
        {
            <div class="flex items-center justify-center py-12">
                <div class="text-center">
                    <div class="inline-block animate-spin mb-4">
                        <div class="w-12 h-12 border-4 border-accent-700/30 border-t-accent-600 rounded-full"></div>
                    </div>
                    <p class="text-text-muted">Načítáme hráče…</p>
                </div>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="rounded-lg bg-red-900/20 border border-red-500/40 text-red-300 p-4" role="alert">
                <p class="text-sm font-medium">@errorMessage</p>
            </div>
        }
        else if (sections.IsEmpty)
        {
            <div class="rounded-lg border border-dashed border-accent-700/50 bg-primary-950/40 p-12 text-center">
                <p class="text-xl text-text-muted">
                    @(!string.IsNullOrWhiteSpace(searchText)
                        ? $"Nikoho s přezdívkou „{searchText.Trim()}“ jsme nenašli"
                        : ActiveTab is null or DiscoveryTabs.AllTab
                            ? "Zatím tu nejsou žádní hráči"
                            : "V této skupině zatím nikdo není")
                </p>
            </div>
        }
        else
        {
            <div class="space-y-10 transition-opacity @(isLoading ? "opacity-60" : "")">
                @foreach (GenderSections<PlayerListItem>.Section section in sections.Sections.Where(s => s.Items.Count > 0))
                {
                    <DiscoverySection TItem="PlayerListItem" Section="section" IsPreview="sections.IsPreview"
                                      ShowAllHref="@(section.Group is { } g ? $"/people?gender={g}" : null)"
                                      OnLoadMore="() => LoadMoreAsync(section)">
                        <ItemTemplate Context="player">
                            <NavLink href="@($"/players/{player.ProfileId}{GroupQuery}")"
                                     class="relative block group rounded-lg overflow-hidden shadow-lg bg-primary-900 transform transition-transform duration-300 hover:scale-105 hover:shadow-accent-700/40 aspect-square cursor-pointer">
                                @if (player.ProfileImageId is not null)
                                {
                                    <img src="@ImageUrls.For(player.ProfileImageId)" alt="Profilová fotka – @player.DisplayName"
                                         loading="lazy" class="absolute inset-0 w-full h-full object-cover"/>
                                }
                                else
                                {
                                    <div class="absolute inset-0 bg-gradient-to-br from-accent-700/40 to-accent-900/20 flex items-center justify-center">
                                        <span class="text-4xl font-bold text-accent-400">@GetInitials(player.DisplayName)</span>
                                    </div>
                                }
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
                                <div class="absolute left-0 bottom-0 z-10 p-4 flex flex-col items-start w-full text-text-default">
                                    <p class="font-bold text-lg">@player.DisplayName</p>
                                    @if (!string.IsNullOrWhiteSpace(player.Description))
                                    {
                                        <p class="text-sm text-text-muted line-clamp-2">@player.Description</p>
                                    }
                                </div>
                            </NavLink>
                        </ItemTemplate>
                    </DiscoverySection>
                }
            </div>
        }
    </div>
</div>

@if (ProfileId is { } openProfileId)
{
    <PlayerDetailModal ProfileId="openProfileId" OnClose="ClosePlayer"/>
}

@code {
    private readonly CancellationTokenSource disposed = new();

    private GenderSections<PlayerListItem> sections = new();
    private bool isLoading = true;
    private bool hasLoaded;
    private string? loadedTab;
    private string? errorMessage;
    private string searchText = string.Empty;
    private CancellationTokenSource? debounce;

    /// <summary>
    ///     Gets or sets the player whose popup is open (from /players/{id}), or <see langword="null" />.
    /// </summary>
    [Parameter]
    public Guid? ProfileId { get; set; }

    /// <summary>
    ///     Gets or sets the tab from the URL (?gender=Women or ?gender=All); absent for Přehled.
    /// </summary>
    [SupplyParameterFromQuery(Name = "gender")]
    public string? GenderQuery { get; set; }

    /// <summary>
    ///     Gets the active tab: <see langword="null" /> for Přehled, a <see cref="GenderGroup" /> name or
    ///     <see cref="DiscoveryTabs.AllTab" /> (unknown values fall back to Přehled).
    /// </summary>
    private string? ActiveTab =>
        string.Equals(GenderQuery, DiscoveryTabs.AllTab, StringComparison.OrdinalIgnoreCase) ? DiscoveryTabs.AllTab
        : Enum.TryParse(GenderQuery, ignoreCase: true, out GenderGroup group) && Enum.IsDefined(group) ? group.ToString()
        : null;

    /// <summary>
    ///     Gets the query to keep on links so opening and closing a player stays on the active tab.
    /// </summary>
    private string GroupQuery => ActiveTab is { } tab ? $"?gender={tab}" : string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        // Opening or closing the player popup changes only ProfileId; reload when the shown group changes.
        if (!hasLoaded || loadedTab != ActiveTab)
        {
            hasLoaded = true;
            await LoadAsync();
        }
    }

    private async Task OnSearchChanged()
    {
        // Wait until the user stops typing; a newer keystroke cancels the pending search.
        debounce?.Cancel();
        debounce = CancellationTokenSource.CreateLinkedTokenSource(disposed.Token);
        CancellationToken token = debounce.Token;

        try
        {
            await Task.Delay(300, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        string? tab = ActiveTab;

        try
        {
            GenderSections<PlayerListItem> loaded = new();
            errorMessage = tab is null
                ? await loaded.ReloadOverviewAsync(FetchAsync)
                : await loaded.ReloadListAsync(Enum.TryParse(tab, out GenderGroup group) ? group : null, FetchAsync);
            sections = loaded;
            loadedTab = tab;
        }
        catch (OperationCanceledException)
        {
            // The page was left while loading.
        }
        catch (Exception ex)
        {
            errorMessage = $"Hráče se nepodařilo načíst: {ex.Message}";
            sections = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadMoreAsync(GenderSections<PlayerListItem>.Section section)
    {
        try
        {
            errorMessage = await section.LoadNextAsync(FetchAsync);
        }
        catch (OperationCanceledException)
        {
            // The page was left while loading.
        }
    }

    private Task<Result<PagedResult<PlayerListItem>>> FetchAsync(GenderGroup? group, int page, int pageSize)
    {
        return SearchPlayersHandler.Handle(
            new SearchPlayersQuery { Search = searchText, Gender = group, Page = page, PageSize = pageSize },
            disposed.Token);
    }

    private void ClosePlayer()
    {
        NavigationManager.NavigateTo($"/people{GroupQuery}");
    }

    private static string GetInitials(string name)
    {
        string[] parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
            _ => string.Concat(parts[0][0], parts[1][0]).ToUpperInvariant(),
        };
    }

    public void Dispose()
    {
        disposed.Cancel();
        disposed.Dispose();
        debounce?.Dispose();
    }
}
