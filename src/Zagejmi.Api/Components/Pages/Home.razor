@page "/"
@rendermode InteractiveServer

@using System.Threading
@using Zagejmi.Application.Abstractions
@using Zagejmi.Application.Profiles.SearchPlayers
@using Zagejmi.Shared
@implements IDisposable

@inject SearchPlayersHandler SearchPlayersHandler

<PageTitle>Zagejmi – hraj s námi</PageTitle>

<div class="font-sans text-gray-800 text-center">
    <div class="p-8 md:p-12 bg-pink-100 rounded-2xl mb-8">
        <h1 class="text-4xl md:text-5xl font-bold text-pink-600 mb-2">Ahoj, vítej na Zagejmi!</h1>
        <p class="text-lg text-gray-700">Najděte si parťáka nebo parťačku na nezapomenutelné herní večery, upřímné rozhovory a spoustu zábavy. Váš nový online kamarád je jen na jedno kliknutí.</p>
    </div>

    @* Recommended players: the top of the same ranking as /people (most complete profiles first, then newest).
       There is no popularity data yet (no orders or reviews are stored), so this does not claim "most popular". *@
    <div class="py-10 px-5">
        <h2 class="text-3xl md:text-4xl font-bold mb-2 text-gray-800">Doporučujeme</h2>
        <p class="text-gray-600 mb-8">Hráči a hráčky s nejúplnějším profilem. Podívejte se, kdo je tu s vámi.</p>

        @if (players is null && errorMessage is null)
        {
            <div class="flex items-center justify-center py-8">
                <div class="inline-block animate-spin">
                    <div class="w-10 h-10 border-4 border-pink-200 border-t-pink-500 rounded-full"></div>
                </div>
            </div>
        }
        else if (errorMessage is not null)
        {
            <div class="rounded-xl bg-red-100 border border-red-300 text-red-700 p-4 max-w-3xl mx-auto" role="alert">
                <p class="text-sm font-medium">@errorMessage</p>
            </div>
        }
        else if (players!.Count == 0)
        {
            <div class="rounded-xl bg-yellow-100 border border-yellow-300 text-yellow-800 p-4 max-w-3xl mx-auto">
                <p class="text-sm font-medium">Zatím tu nikdo není.</p>
            </div>
        }
        else
        {
            <div class="flex flex-wrap justify-center gap-8">
                @foreach (PlayerListItem player in players)
                {
                    <NavLink href="@($"/players/{player.ProfileId}")"
                             class="bg-white rounded-2xl shadow-lg p-6 w-64 transition-transform duration-300 ease-in-out hover:-translate-y-2 hover:shadow-xl">
                        <div class="flex items-center justify-center mb-4">
                            @if (player.ProfileImageId is not null)
                            {
                                <img src="@ImageUrls.For(player.ProfileImageId)" alt="Profilová fotka – @player.DisplayName"
                                     loading="lazy" class="w-28 h-28 rounded-full object-cover border-4 border-pink-100"/>
                            }
                            else
                            {
                                <div
                                    class="w-28 h-28 rounded-full bg-pink-200 text-pink-700 text-3xl font-bold flex items-center justify-center border-4 border-pink-100">
                                    @GetInitials(player.DisplayName)
                                </div>
                            }
                        </div>
                        <h3 class="text-2xl font-bold mb-1 text-pink-600 break-words">@player.DisplayName</h3>
                        @if (!string.IsNullOrWhiteSpace(player.Description))
                        {
                            <p class="text-gray-600 text-sm line-clamp-2">@player.Description</p>
                        }
                    </NavLink>
                }
            </div>
            <a href="/people" class="inline-block mt-8 text-pink-600 font-semibold hover:underline">Zobrazit všechny hráče a hráčky</a>
        }
    </div>

    <div class="py-12 px-5 bg-yellow-100 my-8 rounded-2xl">
        <h2 class="text-3xl font-bold text-yellow-800">Posíláme vřelé objetí</h2>
        <p class="text-gray-700 mt-2">Chceme tu vytvářet pozitivní a přátelské místo. Ať hledáte cokoli, jsme rádi, že jste tady!</p>
    </div>

    <footer class="py-10 px-5 bg-purple-100 rounded-2xl">
        <h2 class="text-2xl font-bold mb-4">Přidáte se k nám?</h2>
        <a href="/become-an-egirl"
           class="inline-block py-3 px-8 text-lg font-bold text-white bg-purple-500 rounded-full no-underline transition-colors duration-300 hover:bg-purple-600">Staňte se hráčem nebo hráčkou</a>
    </footer>
</div>

@code {
    private const int RecommendedCount = 4;

    private readonly CancellationTokenSource disposed = new();
    private IReadOnlyList<PlayerListItem>? players;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Called in-process (no HTTP round trip through the public URL).
            Result<PagedResult<PlayerListItem>> result = await SearchPlayersHandler.Handle(
                new SearchPlayersQuery { Page = 1, PageSize = RecommendedCount },
                disposed.Token);

            if (result.IsSuccess)
            {
                players = result.Value.Items;
            }
            else
            {
                errorMessage = $"Hráče se nepodařilo načíst: {result.Error?.Message}";
            }
        }
        catch (OperationCanceledException)
        {
            // The page was left while loading.
        }
        catch (Exception ex)
        {
            errorMessage = $"Hráče se nepodařilo načíst: {ex.Message}";
        }
    }

    private static string GetInitials(string name)
    {
        string[] parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
            _ => string.Concat(parts[0][0], parts[1][0]).ToUpperInvariant(),
        };
    }

    public void Dispose()
    {
        disposed.Cancel();
        disposed.Dispose();
    }
}
