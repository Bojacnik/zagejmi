@page "/"
@rendermode InteractiveServer

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

<PageTitle>Your E-Girl Companion</PageTitle>

<div class="font-sans text-gray-800 text-center">
    <div class="p-8 md:p-12 bg-pink-100 rounded-2xl mb-8">
        <h1 class="text-4xl md:text-5xl font-bold text-pink-600 mb-2">Hello, Gorgeous!</h1>
        <p class="text-lg text-gray-700">Find your perfect e-girl companion for unforgettable gaming sessions, heartfelt
            chats, and endless fun. Your next online bestie is just a click away.</p>
    </div>

    <div class="py-10 px-5">
        <h2 class="text-3xl md:text-4xl font-bold mb-2 text-gray-800">Pedestal Highlights</h2>
        <p class="text-gray-600 mb-8">Top requested and top starred associates right now.</p>

        @if (isLoadingHighlights)
        {
            <div class="flex items-center justify-center py-8">
                <div class="inline-block animate-spin">
                    <div class="w-10 h-10 border-4 border-pink-200 border-t-pink-500 rounded-full"></div>
                </div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(highlightsError))
        {
            <div class="rounded-xl bg-red-100 border border-red-300 text-red-700 p-4 max-w-3xl mx-auto">
                <p class="text-sm font-medium">@highlightsError</p>
            </div>
        }
        else if (highlights == null || (highlights.MostRequested == null && highlights.MostStarred == null))
        {
            <div class="rounded-xl bg-yellow-100 border border-yellow-300 text-yellow-800 p-4 max-w-3xl mx-auto">
                <p class="text-sm font-medium">No highlight associates yet.</p>
            </div>
        }
        else
        {
            <div class="flex flex-wrap justify-center gap-8">
                @if (highlights.MostRequested != null)
                {
                    <NavLink href="@($"/associates/{highlights.MostRequested.ProfileId}")"
                             class="bg-white rounded-2xl shadow-lg p-6 w-80 transition-transform duration-300 ease-in-out hover:-translate-y-2 hover:shadow-xl">
                        <div class="flex items-center justify-center mb-4">
                            @if (!string.IsNullOrWhiteSpace(highlights.MostRequested.ProfileImageUrl))
                            {
                                <img src="@highlights.MostRequested.ProfileImageUrl"
                                     alt="@highlights.MostRequested.DisplayName"
                                     class="w-28 h-28 rounded-full object-cover border-4 border-pink-100"/>
                            }
                            else
                            {
                                <div
                                    class="w-28 h-28 rounded-full bg-pink-200 text-pink-700 text-3xl font-bold flex items-center justify-center border-4 border-pink-100">
                                    @GetInitials(highlights.MostRequested.DisplayName)
                                </div>
                            }
                        </div>
                        <div
                            class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-pink-100 text-pink-700 mb-2">
                            Most Requested
                        </div>
                        <h3 class="text-2xl font-bold mb-1 text-pink-600">@highlights.MostRequested.DisplayName</h3>
                        <p class="text-gray-600 text-sm">Completed
                            sessions: @highlights.MostRequested.CompletedSessions</p>
                        <p class="text-gray-600 text-sm">⭐ @highlights.MostRequested.Reputation.ToString("F1")</p>
                    </NavLink>
                }

                @if (highlights.MostStarred != null)
                {
                    <NavLink href="@($"/associates/{highlights.MostStarred.ProfileId}")"
                             class="bg-white rounded-2xl shadow-lg p-6 w-80 transition-transform duration-300 ease-in-out hover:-translate-y-2 hover:shadow-xl">
                        <div class="flex items-center justify-center mb-4">
                            @if (!string.IsNullOrWhiteSpace(highlights.MostStarred.ProfileImageUrl))
                            {
                                <img src="@highlights.MostStarred.ProfileImageUrl"
                                     alt="@highlights.MostStarred.DisplayName"
                                     class="w-28 h-28 rounded-full object-cover border-4 border-purple-100"/>
                            }
                            else
                            {
                                <div
                                    class="w-28 h-28 rounded-full bg-purple-200 text-purple-700 text-3xl font-bold flex items-center justify-center border-4 border-purple-100">
                                    @GetInitials(highlights.MostStarred.DisplayName)
                                </div>
                            }
                        </div>
                        <div
                            class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-purple-100 text-purple-700 mb-2">
                            Most Starred
                        </div>
                        <h3 class="text-2xl font-bold mb-1 text-purple-600">@highlights.MostStarred.DisplayName</h3>
                        <p class="text-gray-600 text-sm">⭐ @highlights.MostStarred.Reputation.ToString("F1")</p>
                        <p class="text-gray-600 text-sm">Completed
                            sessions: @highlights.MostStarred.CompletedSessions</p>
                    </NavLink>
                }
            </div>
        }
    </div>

    <div class="py-12 px-5 bg-yellow-100 my-8 rounded-2xl">
        <h2 class="text-3xl font-bold text-yellow-800">Sending You a Warm Hug</h2>
        <p class="text-gray-700 mt-2">We're all about creating a positive and uplifting space. Whatever you're looking
            for, we're happy to have you here!</p>
    </div>

    <footer class="py-10 px-5 bg-purple-100 rounded-2xl">
        <h2 class="text-2xl font-bold mb-4">Ready to Join Us?</h2>
        <a href="/become-an-egirl"
           class="inline-block py-3 px-8 text-lg font-bold text-white bg-purple-500 rounded-full no-underline transition-colors duration-300 hover:bg-purple-600">Become
            an E-Girl</a>
    </footer>
</div>

@code {
    private bool isLoadingHighlights = true;
    private string? highlightsError;
    private HighlightsResponse? highlights;

    protected override async Task OnInitializedAsync()
    {
        await LoadHighlightsAsync();
    }

    private async Task LoadHighlightsAsync()
    {
        HttpClient client = HttpClientFactory.CreateClient();
        client.BaseAddress = new Uri(NavigationManager.BaseUri);

        HttpResponseMessage response = await client.GetAsync("api/v1/read/associates/highlights");
        if (!response.IsSuccessStatusCode)
        {
            string errorText = await response.Content.ReadAsStringAsync();
            highlightsError = $"Highlights failed: {(int)response.StatusCode} {response.StatusCode}. {errorText}";
            isLoadingHighlights = false;
            return;
        }

        highlights = await response.Content.ReadFromJsonAsync<HighlightsResponse>();
        isLoadingHighlights = false;
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        string[] parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return name[..1].ToUpperInvariant();
        }

        if (parts.Length == 1)
        {
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        }

        return string.Concat(parts[0][0], parts[1][0]).ToUpperInvariant();
    }

    private sealed class HighlightsResponse
    {
        public HighlightAssociate? MostRequested { get; set; }

        public HighlightAssociate? MostStarred { get; set; }
    }

    private sealed class HighlightAssociate
    {
        public Guid ProfileId { get; set; }

        public string DisplayName { get; } = string.Empty;

        public string? ProfileImageUrl { get; set; }

        public decimal Reputation { get; set; }

        public int CompletedSessions { get; set; }

        public bool IsOnline { get; set; }
    }

}
