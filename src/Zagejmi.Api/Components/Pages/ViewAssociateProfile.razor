@page "/associates/{ProfileId:guid}"
@using System.Net
@using Zagejmi.Contracts.Dtos
@rendermode InteractiveServer

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

<PageTitle>Associate Profile</PageTitle>

@if (isLoading)
{
    <div class="min-h-screen flex items-center justify-center bg-primary-950/50">
        <div class="text-center">
            <div class="inline-block animate-spin mb-4">
                <div class="w-12 h-12 border-4 border-accent-700/30 border-t-accent-600 rounded-full"></div>
            </div>
            <p class="text-text-muted">Loading associate profile...</p>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="min-h-screen flex items-center justify-center bg-primary-950/50 px-4">
        <div class="max-w-md w-full p-6 rounded-2xl bg-red-900/20 border border-red-500/40">
            <h2 class="text-xl font-bold text-red-300 mb-2">Unable to Load Profile</h2>
            <p class="text-red-200 text-sm mb-4">@errorMessage</p>
            <button @onclick="NavigateToAssociates"
                    class="w-full px-4 py-2 rounded-lg bg-red-700 hover:bg-red-600 text-white font-semibold transition-colors">
                Back to Associates
            </button>
        </div>
    </div>
}
else if (profile is not null)
{
    <div class="w-full">
        @* ========== BANNER SECTION ========== *@
        <div
            class="relative w-full h-64 sm:h-80 lg:h-96 overflow-hidden bg-gradient-to-b from-primary-900 to-primary-950">
            @if (!string.IsNullOrWhiteSpace(profile.BannerImageUrl))
            {
                <img src="@profile.BannerImageUrl" alt="Associate banner"
                     class="w-full h-full object-cover"/>
            }
            else
            {
                @* Fallback gradient banner *@
                <div class="w-full h-full bg-gradient-to-br from-accent-700/20 via-primary-900 to-accent-900/10"></div>
            }

            @* Overlay for depth *@
            <div class="absolute inset-0 bg-gradient-to-t from-primary-950 via-transparent to-transparent"></div>

            @* Back Button *@
            <button @onclick="NavigateToAssociates"
                    class="absolute top-4 left-4 z-10 px-4 py-2 rounded-lg bg-primary-900/80 backdrop-blur-sm border border-accent-700/50 text-text-default hover:bg-primary-800 transition-colors">
                ← Back
            </button>
        </div>

        @* ========== MAIN CONTENT AREA ========== *@
        <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="grid lg:grid-cols-3 gap-8">
                @* ========== LEFT COLUMN: PROFILE CARD ========== *@
                <div class="lg:col-span-1">
                    <div
                        class="sticky top-8 rounded-2xl border border-accent-700/50 bg-primary-950/80 backdrop-blur-sm overflow-hidden shadow-2xl">
                        @* Profile Picture *@
                        <div class="relative">
                            <div
                                class="absolute inset-0 -top-20 h-24 bg-gradient-to-br from-accent-600/20 to-accent-900/10"></div>
                            <div class="relative px-6 pt-6 flex flex-col items-center">
                                @if (!string.IsNullOrWhiteSpace(profile.ProfileImageUrl))
                                {
                                    <img src="@profile.ProfileImageUrl" alt="@profile.DisplayName"
                                         class="w-24 h-24 rounded-full object-cover border-4 border-accent-600/80 shadow-lg"/>
                                }
                                else
                                {
                                    <div
                                        class="w-24 h-24 rounded-full bg-accent-700 text-text-default text-3xl font-bold flex items-center justify-center border-4 border-accent-600/80 shadow-lg">
                                        @BuildInitials(profile.DisplayName)
                                    </div>
                                }

                                @* Online Status Indicator *@
                                @if (profile.IsOnline)
                                {
                                    <div
                                        class="absolute bottom-0 right-12 w-6 h-6 rounded-full bg-green-500 border-4 border-primary-950 shadow-lg"></div>
                                }
                            </div>
                        </div>

                        @* Profile Info *@
                        <div class="px-6 py-4 text-center">
                            <h1 class="text-2xl font-bold text-text-default">@profile.DisplayName</h1>
                            <div class="flex items-center justify-center gap-2 mt-2 text-sm">
                                <span
                                    class="inline-flex items-center px-2 py-1 rounded-full bg-accent-700/30 text-accent-300 border border-accent-600/50">
                                    ⭐ Associate
                                </span>
                                @if (profile.IsOnline)
                                {
                                    <span
                                        class="inline-flex items-center px-2 py-1 rounded-full bg-green-700/30 text-green-300 border border-green-600/50">
                                        🟢 Online
                                    </span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(profile.Bio))
                            {
                                <p class="text-text-muted text-sm mt-3 leading-relaxed">@profile.Bio</p>
                            }
                        </div>

                        @* Stats Section *@
                        <div class="grid grid-cols-3 gap-2 px-6 py-4 border-t border-accent-800/40 bg-primary-900/30">
                            <div class="text-center">
                                <p class="text-2xl font-bold text-accent-300">@profile.Reputation.ToString("F1")</p>
                                <p class="text-xs text-text-muted mt-1">Reputation</p>
                            </div>
                            <div class="text-center">
                                <p class="text-2xl font-bold text-accent-300">@profile.Level</p>
                                <p class="text-xs text-text-muted mt-1">Level</p>
                            </div>
                            <div class="text-center">
                                <p class="text-2xl font-bold text-accent-300">@profile.CompletedSessions</p>
                                <p class="text-xs text-text-muted mt-1">Completed</p>
                            </div>
                        </div>

                        @* Action Buttons *@
                        <div class="px-6 py-4 border-t border-accent-800/40 flex flex-col gap-2">
                            <button
                                class="w-full px-4 py-2 rounded-lg font-semibold text-primary-950 bg-accent-600 hover:bg-accent-700 transition-colors">
                                💬 Send Message
                            </button>
                            <button
                                class="w-full px-4 py-2 rounded-lg font-semibold text-text-default bg-primary-800 hover:bg-primary-700 transition-colors border border-accent-700/50">
                                🔗 Add Friend
                            </button>
                        </div>

                        @* Member Since *@
                        <div
                            class="px-6 py-3 text-xs text-text-muted text-center border-t border-accent-800/40 bg-primary-950/50">
                            Member since @profile.CreatedAt.ToString("MMMM yyyy")
                        </div>
                    </div>
                </div>

                @* ========== RIGHT COLUMN: SERVICES LIST ========== *@
                <div class="lg:col-span-2">
                    @* Services Header *@
                    <div class="mb-6">
                        <h2 class="text-3xl font-bold text-text-default">Services</h2>
                        <p class="text-text-muted mt-1">Explore the services offered by @profile.DisplayName</p>
                    </div>

                    @if (profile.Services.Count == 0)
                    {
                        <div
                            class="rounded-2xl border border-dashed border-accent-700/50 bg-primary-950/40 p-12 text-center">
                            <p class="text-xl text-text-muted mb-2">🔍 No services available</p>
                            <p class="text-sm text-text-muted">This associate hasn't added any services yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="grid sm:grid-cols-2 gap-6">
                            @foreach (ServiceDto service in profile.Services)
                            {
                                <ServiceCard Service="@service"/>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const string UnknownValue = "Not available";
    private const string PeopleRoute = "/people";

    /// <summary>
    ///     The Associate profile ID from the route parameter.
    /// </summary>
    [Parameter]
    public Guid ProfileId { get; set; }

    private bool isLoading = true;
    private string? errorMessage;
    private AssociateProfileDto? profile;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadProfileAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>
    ///     Navigates back to the Associates list page.
    /// </summary>
    private void NavigateToAssociates()
    {
        NavigationManager.NavigateTo(PeopleRoute);
    }

    /// <summary>
    ///     Loads the associate profile from the API.
    /// </summary>
    private async Task LoadProfileAsync()
    {
        HttpClient readApi = CreateReadApiClient();

        try
        {
            HttpResponseMessage response =
                await readApi.GetAsync($"api/v1/read/associates/{ProfileId}");

            if (!response.IsSuccessStatusCode)
            {
                string responseText = await response.Content.ReadAsStringAsync();
                errorMessage = ExtractErrorMessage(response.StatusCode, responseText);
                return;
            }

            profile = await response.Content.ReadFromJsonAsync<AssociateProfileDto>();
            if (profile is null)
            {
                errorMessage = "Failed to parse profile data.";
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Network error: {ex.Message}";
        }
    }

    /// <summary>
    ///     Builds initials from a display name.
    /// </summary>
    private static string BuildInitials(string value)
    {
        if (string.IsNullOrWhiteSpace(value) || value == UnknownValue)
        {
            return "?";
        }

        string[] parts = value.Split([' ', '.', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return value[..1].ToUpperInvariant();
        }

        if (parts.Length == 1)
        {
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        }

        return string.Concat(parts[0][0], parts[1][0]).ToUpperInvariant();
    }

    /// <summary>
    ///     Extracts error message from the response.
    /// </summary>
    private static string ExtractErrorMessage(HttpStatusCode statusCode, string body)
    {
        if (string.IsNullOrWhiteSpace(body))
        {
            return $"Request failed with status {(int)statusCode}.";
        }

        return body.Length > 200 ? body[..200] + "..." : body;
    }

    /// <summary>
    ///     Creates and configures the read API HTTP client.
    /// </summary>
    private HttpClient CreateReadApiClient()
    {
        HttpClient client = HttpClientFactory.CreateClient();
        client.BaseAddress = new Uri(NavigationManager.BaseUri);
        return client;
    }

}

