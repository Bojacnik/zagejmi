@page "/verify-email"
@using Zagejmi.Api.Localization
@using Zagejmi.Application.Auth.Users.VerifyEmail
@using Zagejmi.Shared
@rendermode InteractiveServer

@inject VerifyEmailHandler VerifyEmailHandler
@inject NavigationManager NavigationManager

<PageTitle>Ověření e-mailu – Zagejmi</PageTitle>

<div class="w-full h-full flex items-center justify-center p-4">
    <div
        class="w-full max-w-lg p-8 space-y-4 bg-primary-900 rounded-xl border border-accent-700/50 shadow-2xl shadow-accent-900/30">
        <h1 class="text-3xl font-bold text-gray-100">Ověření e-mailu</h1>

        @if (isLoading)
        {
            <p class="text-gray-300">Ověřujeme váš e-mail…</p>
        }
        else if (isSuccess)
        {
            <div class="p-4 text-sm text-green-400 bg-green-900/30 border border-green-400/50 rounded-lg">
                <p>@message</p>
            </div>
            <button class="px-4 py-3 font-bold text-white bg-accent-600 hover:bg-accent-700 rounded-lg"
                    @onclick="GoToLogin">
                Přejít na přihlášení
            </button>
        }
        else
        {
            <div class="p-4 text-sm text-red-400 bg-red-900/30 border border-red-400/50 rounded-lg">
                <p>@message</p>
            </div>
            <div class="flex gap-3">
                <button class="px-4 py-3 font-bold text-white bg-accent-600 hover:bg-accent-700 rounded-lg"
                        @onclick="GoToLogin">
                    Přejít na přihlášení
                </button>
                <button class="px-4 py-3 font-bold text-white bg-primary-700 hover:bg-primary-600 rounded-lg"
                        @onclick="GoToRegister">
                    Přejít na registraci
                </button>
            </div>
        }
    </div>
</div>

@code {

    [SupplyParameterFromQuery] private string? UserId { get; set; }

    [SupplyParameterFromQuery] private string? Token { get; set; }

    private bool isLoading = true;
    private bool isSuccess;
    private string message = string.Empty;
    private bool hasAttempted;

    protected override async Task OnParametersSetAsync()
    {
        if (hasAttempted)
        {
            return;
        }

        hasAttempted = true;

        if (!Guid.TryParse(UserId, out Guid userId) || string.IsNullOrWhiteSpace(Token))
        {
            isLoading = false;
            isSuccess = false;
            message = "Neplatný ověřovací odkaz.";
            return;
        }

        try
        {
            Result<long> result = await VerifyEmailHandler.Handle(new VerifyEmailCommand(userId, Token));

            if (result.IsSuccess)
            {
                isSuccess = true;
                message = result.Value > 0
                    ? $"E-mail je ověřený a na váš zákaznický účet jsme připsali bonus {CzechLabels.Goins(result.Value)}. Teď se můžete přihlásit."
                    : "E-mail je ověřený. Teď se můžete přihlásit.";
            }
            else
            {
                message = result.Error!.Message;
            }
        }
        catch (Exception)
        {
            isSuccess = false;
            message = "E-mail teď nejde ověřit. Zkuste to prosím později.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoToLogin()
    {
        NavigationManager.NavigateTo("/login");
    }

    private void GoToRegister()
    {
        NavigationManager.NavigateTo("/register");
    }

}

