@page "/verify-email"
@using System.Text.Json
@using Zagejmi.Api.Models
@rendermode InteractiveServer

@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

<div class="w-full h-full flex items-center justify-center p-4">
    <div
        class="w-full max-w-lg p-8 space-y-4 bg-primary-900 rounded-xl border border-accent-700/50 shadow-2xl shadow-accent-900/30">
        <h1 class="text-3xl font-bold text-gray-100">Ověření e-mailu</h1>

        @if (isLoading)
        {
            <p class="text-gray-300">Ověřujeme váš e-mail…</p>
        }
        else if (isSuccess)
        {
            <div class="p-4 text-sm text-green-400 bg-green-900/30 border border-green-400/50 rounded-lg">
                <p>@message</p>
            </div>
            <button class="px-4 py-3 font-bold text-white bg-accent-600 hover:bg-accent-700 rounded-lg"
                    @onclick="GoToLogin">
                Přejít na přihlášení
            </button>
        }
        else
        {
            <div class="p-4 text-sm text-red-400 bg-red-900/30 border border-red-400/50 rounded-lg">
                <p>@message</p>
            </div>
            <div class="flex gap-3">
                <button class="px-4 py-3 font-bold text-white bg-accent-600 hover:bg-accent-700 rounded-lg"
                        @onclick="GoToLogin">
                    Přejít na přihlášení
                </button>
                <button class="px-4 py-3 font-bold text-white bg-primary-700 hover:bg-primary-600 rounded-lg"
                        @onclick="GoToRegister">
                    Přejít na registraci
                </button>
            </div>
        }
    </div>
</div>

@code {

    [SupplyParameterFromQuery] private string? UserId { get; set; }

    [SupplyParameterFromQuery] private string? Token { get; set; }

    private bool isLoading = true;
    private bool isSuccess;
    private string message = string.Empty;
    private bool hasAttempted;

    protected override async Task OnParametersSetAsync()
    {
        if (hasAttempted)
        {
            return;
        }

        hasAttempted = true;

        if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Token))
        {
            isLoading = false;
            isSuccess = false;
            message = "Neplatný ověřovací odkaz.";
            return;
        }

        try
        {
            string endpoint =
                $"api/v1/auth/verify-email/confirm?userId={Uri.EscapeDataString(UserId)}&token={Uri.EscapeDataString(Token)}";

            HttpClient client = HttpClientFactory.CreateClient("WriteAPI");
            HttpResponseMessage response = await client.GetAsync(endpoint);

            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
                message = "E-mail je ověřený. Teď se můžete přihlásit.";
            }
            else
            {
                string payload = await response.Content.ReadAsStringAsync();
                message = TryReadError(payload) ?? "E-mail se nepodařilo ověřit. Odkaz je možná neplatný nebo mu vypršela platnost.";
            }
        }
        catch
        {
            isSuccess = false;
            message = "E-mail teď nejde ověřit. Zkuste to prosím později.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoToLogin()
    {
        NavigationManager.NavigateTo("/login");
    }

    private void GoToRegister()
    {
        NavigationManager.NavigateTo("/register");
    }

    private static string? TryReadError(string payload)
    {
        if (string.IsNullOrWhiteSpace(payload))
        {
            return null;
        }

        ValidationErrorResponse? response = JsonSerializer.Deserialize<ValidationErrorResponse>(payload);
        return response?.Errors.FirstOrDefault();
    }

}

