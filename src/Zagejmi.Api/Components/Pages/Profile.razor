    private async Task CreateProfile()
    {
        createErrorMessage = null;

        if (availableTypes.Count == 0)
        {
            createErrorMessage = "All profile types already exist for this user.";
            return;
        }

        if (RequiresDisplayName(newProfileType) && string.IsNullOrWhiteSpace(newDisplayName))
        {
            createErrorMessage = "Display name is required for Customer and Associate profiles.";
            return;
        }

        string effectiveDisplayName = newProfileType == ProfileType.Anon
            ? $"anon-{Guid.NewGuid():N}"[..13]
            : newDisplayName.Trim();

        string? profileImageUrl = newProfileType == ProfileType.Customer ? newCustomerImageDataUrl : null;

        UserCreateProfileCommand command = new()
        {
            UserId = currentUserId,
            ProfileType = ToWriteProfileType(newProfileType),
            DisplayName = effectiveDisplayName,
            ProfileImageDataUrl = profileImageUrl,
        };

        HttpClient writeApi = CreateWriteApiClient();
        HttpResponseMessage response = await writeApi.PostAsJsonAsync($"api/v1/users/{currentUserId}/profiles", command);

        if (!response.IsSuccessStatusCode)
        {
            string responseText = await response.Content.ReadAsStringAsync();
            createErrorMessage = ExtractErrorMessage(response.StatusCode, responseText);
            return;
        }

        await LoadProfilesAsync();
        showCreatePanel = false;
        newDisplayName = string.Empty;
        newCustomerImageDataUrl = null;
        customerImageErrorMessage = null;
    }

