@page "/profile"
@using System.Globalization
@using System.IdentityModel.Tokens.Jwt
@using System.IO
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Zagejmi.Api.Localization
@using Zagejmi.Api.Models
@using Zagejmi.Application.Auth.Users.SetDefaultProfile
@using Zagejmi.Application.Auth.Users.SetGhostMode
@using Zagejmi.Application.Images
@using Zagejmi.Application.Images.Abstractions
@using Zagejmi.Application.Profiles.AddPlayerService
@using Zagejmi.Application.Profiles.CreatePlayerProfile
@using Zagejmi.Application.Profiles.DeletePlayerService
@using Zagejmi.Application.Profiles.GetPlayerDetail
@using Zagejmi.Application.Profiles.SetPlayerBanner
@using Zagejmi.Application.Profiles.SetProfileImage
@using Zagejmi.Application.Profiles.UpdatePlayerService
@using Zagejmi.Application.Profiles.GetUserProfiles
@using Zagejmi.Domain.Auth
@using Zagejmi.Shared
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable

@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ActiveProfileService ActiveProfiles
@inject SetDefaultProfileHandler SetDefaultProfileHandler
@inject SetProfileImageHandler SetProfileImageHandler
@inject SetPlayerBannerHandler SetPlayerBannerHandler
@inject IImageProcessor ImageProcessor
@inject AddPlayerServiceHandler AddPlayerServiceHandler
@inject UpdatePlayerServiceHandler UpdatePlayerServiceHandler
@inject DeletePlayerServiceHandler DeletePlayerServiceHandler
@inject GetPlayerDetailHandler GetPlayerDetailHandler
@inject CreatePlayerProfileHandler CreatePlayerProfileHandler
@inject SetGhostModeHandler SetGhostModeHandler

<PageTitle>Profil – Zagejmi</PageTitle>

<div class="w-full max-w-6xl mx-auto py-8 px-4 sm:px-8">
    <div
        class="rounded-3xl border border-accent-800/40 bg-linear-to-br from-primary-900/80 via-primary-950/80 to-primary-900/70 p-6 sm:p-8 shadow-2xl shadow-primary-950/50">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
            <div>
                <h1 class="text-4xl font-extrabold tracking-tight text-text-default">Moje profily</h1>
                <p class="text-text-muted mt-2">Přepínejte mezi svými profily a spravujte je na jednom místě.</p>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="mt-8 text-center p-8 bg-primary-900/40 rounded-2xl border border-accent-700/40">
                <p class="text-text-muted animate-pulse">Načítáme profil…</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="mt-8 p-4 text-sm text-red-300 bg-red-900/20 border border-red-500/40 rounded-xl" role="alert">
                <h2 class="font-bold">Profil se nepodařilo načíst</h2>
                <p>@errorMessage</p>
            </div>
        }
        else
        {
            <div class="mt-8 space-y-6">
                <div class="rounded-2xl border border-accent-800/40 bg-primary-950/50 p-4">
                    <div class="flex flex-wrap items-center gap-3">
                        @foreach (UserProfileCard profile in profiles)
                        {
                            <button @onclick="() => SelectProfile(profile.Type)"
                                    class="px-4 py-2 rounded-full text-sm font-semibold transition-colors @(selectedProfile?.Type == profile.Type ? "bg-accent-600 text-white" : "bg-primary-900 text-text-muted hover:text-text-default hover:bg-primary-800")">
                                @GetTypeLabel(profile.Type)
                            </button>
                        }

                        @if (CanAddProfile)
                        {
                            <button @onclick="OpenCreatePanel"
                                    class="w-10 h-10 rounded-full border border-accent-600 text-accent-300 hover:bg-accent-700/20 transition-colors text-xl font-bold"
                                    aria-label="Vytvořit profil">
                                +
                            </button>
                        }
                    </div>
                </div>

                @if (showCreatePanel)
                {
                    <section class="rounded-2xl border border-accent-700/50 bg-primary-900/50 p-6">
                        <h2 class="text-2xl font-bold text-text-default">Vytvořit profil @PlayerGenitive</h2>
                        <p class="text-text-muted mt-1">Ke svému zákaznickému profilu si můžete přidat jeden profil @PlayerGenitive.</p>

                        <div class="grid sm:grid-cols-2 gap-4 mt-5">
                            <div>
                                <label class="block text-sm text-text-muted mb-2">Typ profilu</label>
                                <select @bind="newProfileType"
                                        class="w-full rounded-lg bg-primary-950 border border-accent-800/70 px-3 py-2 text-text-default">
                                    @foreach (ProfileType type in availableTypes)
                                    {
                                        <option value="@type">@GetTypeLabel(type)</option>
                                    }
                                </select>
                            </div>

                            @if (RequiresDisplayName(newProfileType))
                            {
                                <div>
                                    <label class="block text-sm text-text-muted mb-2">Přezdívka</label>
                                    <input @bind="newDisplayName" maxlength="40"
                                           class="w-full rounded-lg bg-primary-950 border border-accent-800/70 px-3 py-2 text-text-default"
                                           placeholder="Zadejte přezdívku"/>
                                </div>
                            }
                        </div>

                        @if (newProfileType == ProfileType.Customer)
                        {
                            <div class="mt-5">
                                <label class="block text-sm text-text-muted mb-2">Profilová fotka (PNG/JPEG, max. 2 MB)</label>
                                <InputFile OnChange="OnCustomerImageSelected" accept="image/png,image/jpeg,image/webp"
                                           class="block w-full text-sm text-text-default file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-accent-700 file:text-white hover:file:bg-accent-600"/>
                                @if (!string.IsNullOrWhiteSpace(customerImageErrorMessage))
                                {
                                    <p class="text-sm text-red-300 mt-2">@customerImageErrorMessage</p>
                                }
                                else if (!string.IsNullOrWhiteSpace(newCustomerImageDataUrl))
                                {
                                    <img src="@newCustomerImageDataUrl" alt="Náhled profilové fotky"
                                         class="mt-3 h-20 w-20 rounded-full object-cover border border-accent-700/50"/>
                                }
                            </div>
                        }

                        <div class="flex items-center gap-3 mt-5">
                            <button @onclick="CreateProfile"
                                    class="px-4 py-2 rounded-lg font-semibold bg-accent-600 hover:bg-accent-700 text-white transition-colors">
                                Vytvořit profil
                            </button>
                            <button @onclick="CloseCreatePanel"
                                    class="px-4 py-2 rounded-lg font-semibold bg-primary-800 hover:bg-primary-700 text-text-default transition-colors">
                                Zrušit
                            </button>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(createErrorMessage))
                        {
                            <p class="text-sm text-red-300 mt-4">@createErrorMessage</p>
                        }
                    </section>
                }

                @if (selectedProfile is null)
                {
                    <div class="min-h-[45vh] grid place-items-center">
                        <section
                            class="w-full max-w-3xl rounded-2xl border border-dashed border-accent-700/50 bg-primary-950/40 p-10 text-center">
                            <h2 class="text-3xl font-bold text-text-default">Zatím nemáte žádný profil</h2>
                            <p class="text-text-muted mt-2 max-w-2xl mx-auto">Zákaznický profil se vytváří při registraci. Pokud ho nevidíte, kontaktujte prosím podporu.</p>
                        </section>
                    </div>
                }
                else
                {
                    @switch (selectedProfile.Type)
                    {
                        case ProfileType.Customer:
                            <section class="grid lg:grid-cols-3 gap-6">
                                <div class="rounded-2xl border border-accent-700/50 bg-primary-950/60 p-6 flex flex-col items-center">
                                    @AvatarPicker
                                    <h3 class="text-2xl font-bold text-text-default text-center mt-4">@selectedProfile.DisplayName</h3>
                                    <p class="text-text-muted text-center mt-1">Zákaznický profil</p>
                                    @PictureControls
                                </div>
                                <div
                                    class="lg:col-span-2 rounded-2xl border border-accent-700/50 bg-primary-900/60 p-6">
                                    <h3 class="text-xl font-bold text-text-default">Statistiky</h3>
                                    <p class="text-text-muted text-sm mt-1">Zatím jen ukázkové hodnoty.</p>
                                    <div class="mt-5 grid sm:grid-cols-3 gap-4">
                                        <div class="rounded-xl bg-primary-950/60 border border-accent-900/50 p-4">
                                            <p class="text-xs text-text-muted">Úroveň</p>
                                            <p class="text-3xl font-bold text-accent-300">@selectedProfile.Stats.Level</p>
                                        </div>
                                        <div class="rounded-xl bg-primary-950/60 border border-accent-900/50 p-4">
                                            <p class="text-xs text-text-muted">Hodnocení</p>
                                            <p class="text-3xl font-bold text-accent-300">@selectedProfile.Stats.Reputation</p>
                                        </div>
                                        <div class="rounded-xl bg-primary-950/60 border border-accent-900/50 p-4">
                                            <p class="text-xs text-text-muted">Odehraná sezení</p>
                                            <p class="text-3xl font-bold text-accent-300">@selectedProfile.Stats.CompletedSessions</p>
                                        </div>
                                    </div>
                                </div>
                            </section>
                            break;
                        case ProfileType.Player:
                            <section class="rounded-2xl border border-accent-700/50 bg-primary-900/60 p-6 space-y-4">
                                <h3 class="text-2xl font-bold text-text-default">Profil @PlayerGenitive</h3>
                                <p class="text-text-muted">Přezdívka: <span
                                        class="text-text-default font-semibold">@selectedProfile.DisplayName</span></p>

                                @* Associate banner and profile image management *@
                                <div class="grid lg:grid-cols-3 gap-4">
                                    <div
                                        class="lg:col-span-1 rounded-xl bg-primary-950/60 border border-accent-900/50 p-4">
                                        <p class="text-xs text-text-muted">Profilová fotka</p>
                                        <div class="mt-2 flex flex-col items-center">
                                            @AvatarPicker
                                            @PictureControls
                                        </div>
                                    </div>

                                    <div
                                        class="lg:col-span-2 rounded-xl bg-primary-950/60 border border-accent-900/50 p-4">
                                        <p class="text-xs text-text-muted">Banner</p>

                                        @* Click (or tap) the banner to change it; the input lives inside so keyboard focus shows the overlay too. *@
                                        <label title="Změnit banner"
                                               class="group relative mt-2 block w-full aspect-[4/1] overflow-hidden rounded-md border border-accent-700/50 cursor-pointer focus-within:ring-2 focus-within:ring-accent-500">
                                            @if (!string.IsNullOrWhiteSpace(associateDetails?.BannerImageUrl))
                                            {
                                                <img src="@associateDetails.BannerImageUrl" alt="Banner"
                                                     class="w-full h-full object-cover"/>
                                            }
                                            else
                                            {
                                                <div class="w-full h-full bg-linear-to-br from-accent-600/50 via-accent-900/60 to-primary-950"></div>
                                            }
                                            <span class="absolute inset-0 flex items-center justify-center gap-2 bg-black/55 text-white font-semibold opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity">
                                                @CameraIcon
                                                Změnit banner
                                            </span>
                                            @* Touch screens have no hover: show a small badge instead. *@
                                            <span class="touch-only absolute right-2 bottom-2 w-9 h-9 items-center justify-center rounded-full bg-black/60 text-white">
                                                @CameraIcon
                                            </span>
                                            <InputFile @key="bannerInputKey" @ref="bannerInput" OnChange="OnBannerPicked"
                                                       accept="image/png,image/jpeg,image/webp" class="sr-only"
                                                       aria-label="Změnit banner"/>
                                        </label>
                                        <p class="mt-2 text-xs text-text-muted">Poměr 4 : 1, ideálně aspoň 1600 × 400 px. JPG, PNG nebo WebP do 10 MB.</p>
                                        @if (!string.IsNullOrWhiteSpace(bannerErrorMessage))
                                        {
                                            <p class="text-sm text-red-300 mt-2">@bannerErrorMessage</p>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(bannerSuccessMessage))
                                        {
                                            <p class="text-sm text-green-300 mt-2">@bannerSuccessMessage</p>
                                        }
                                    </div>
                                </div>

                                @* Services management panel *@
                                <div class="rounded-xl border border-accent-800/40 bg-primary-950/40 p-4">
                                    @{ int serviceCount = associateDetails?.Services?.Count ?? 0; }
                                    <div class="flex flex-wrap items-center justify-between gap-3">
                                        <div>
                                            <h4 class="text-lg font-bold">Služby (@serviceCount)</h4>
                                            <div class="text-sm text-text-muted">Můžete přidat až @AddPlayerServiceHandler.MaxServicesPerPlayer služeb.</div>
                                        </div>
                                        <button type="button" @onclick="OpenAddService"
                                                disabled="@(isSavingService || serviceCount >= AddPlayerServiceHandler.MaxServicesPerPlayer)"
                                                class="inline-flex items-center gap-2 px-4 py-2 rounded-lg font-semibold bg-accent-600 hover:bg-accent-700 text-white transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-width="2" d="M12 5v14M5 12h14"></path>
                                            </svg>
                                            Přidat službu
                                        </button>
                                    </div>

                                    <div class="mt-4 space-y-3">
                                        @if (associateDetails?.Services is not null && associateDetails.Services.Count > 0)
                                        {
                                            <div class="grid sm:grid-cols-2 gap-4">
                                                @foreach (ServiceDto svc in associateDetails.Services)
                                                {
                                                    bool isEditing = editingServiceId == svc.ServiceId;
                                                    <div class="rounded-lg border p-3 bg-primary-900/50 flex gap-3 transition-colors @(isEditing ? "border-accent-500 ring-2 ring-accent-500/40" : "border-accent-800/30")">
                                                        @if (!string.IsNullOrWhiteSpace(svc.ImageUrl))
                                                        {
                                                            <img src="@svc.ImageUrl" alt=""
                                                                 class="w-24 aspect-video self-start shrink-0 object-cover rounded-md bg-primary-900/30"/>
                                                        }
                                                        else
                                                        {
                                                            <div class="w-24 aspect-video self-start shrink-0 rounded-md bg-linear-to-br from-accent-700/40 to-accent-900/20"></div>
                                                        }
                                                        <div class="flex-1 min-w-0">
                                                            <div class="font-semibold truncate">@svc.Name</div>
                                                            <div class="text-xs text-text-muted">@(string.IsNullOrWhiteSpace(svc.Category) ? "" : svc.Category + " • ")@CzechLabels.Goins(svc.Price) @svc.PriceSuffix</div>
                                                            @if (CzechLabels.ServiceGame(svc.GameKey, svc.RankKey, svc.PlayStyles) is { } gameLine)
                                                            {
                                                                <div class="text-xs text-accent-300 truncate">@gameLine</div>
                                                            }

                                                            @if (deletingServiceId == svc.ServiceId)
                                                            {
                                                                <div class="mt-2 flex flex-wrap items-center gap-2 text-sm" role="alert">
                                                                    <span class="text-red-300">Opravdu smazat?</span>
                                                                    <button type="button" @onclick="() => DeleteServiceAsync(svc.ServiceId)" disabled="@isSavingService"
                                                                            class="px-3 py-1 rounded-md font-semibold bg-red-600 hover:bg-red-700 text-white transition-colors disabled:opacity-50">
                                                                        Ano, smazat
                                                                    </button>
                                                                    <button type="button" @onclick="() => deletingServiceId = null"
                                                                            class="px-3 py-1 rounded-md font-semibold bg-primary-800 hover:bg-primary-700 text-text-default transition-colors">
                                                                        Ne
                                                                    </button>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="mt-2 flex items-center gap-2">
                                                                    <button type="button" @onclick="() => StartEditService(svc)"
                                                                            disabled="@isSavingService"
                                                                            class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-semibold bg-primary-800 hover:bg-primary-700 text-text-default transition-colors disabled:opacity-50">
                                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m16.86 3.49 3.65 3.65M4 20l1-4.5L16.86 3.5l3.65 3.65L8.5 19 4 20z"></path>
                                                                        </svg>
                                                                        Upravit
                                                                    </button>
                                                                    <button type="button" @onclick="() => { deletingServiceId = svc.ServiceId; serviceErrorMessage = null; }"
                                                                            disabled="@isSavingService"
                                                                            class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-semibold text-red-300 hover:bg-red-900/30 transition-colors disabled:opacity-50">
                                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M10 11v6M14 11v6M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2l1-12M9 7V4h6v3"></path>
                                                                        </svg>
                                                                        Smazat
                                                                    </button>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="text-sm text-text-muted">Zatím nenabízíte žádné služby. Přidejte první tlačítkem nahoře.</p>
                                        }

                                        @if (!isServiceFormOpen)
                                        {
                                            @if (!string.IsNullOrWhiteSpace(serviceErrorMessage))
                                            {
                                                <p class="text-sm text-red-300">@serviceErrorMessage</p>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(serviceSuccessMessage))
                                            {
                                                <p class="text-sm text-green-300">@serviceSuccessMessage</p>
                                            }
                                        }
                                    </div>
                                </div>
                            </section>
                            break;
                    }
                }

                @if (profiles.Count > 1)
                {
                    <section class="rounded-2xl border border-accent-800/40 bg-primary-950/40 p-6">
                        <div class="flex flex-wrap items-center justify-between gap-4">
                            <div>
                                <h3 class="text-lg font-bold text-text-default">Výchozí profil</h3>
                                <p class="text-text-muted text-sm mt-1">
                                    Tento profil se zapne po přihlášení. Kdykoli ho můžete přepnout vpravo nahoře.
                                </p>
                            </div>
                            <div role="radiogroup" aria-label="Výchozí profil"
                                 class="flex items-center gap-1 p-1 rounded-full bg-primary-950/70 border border-accent-700/60">
                                @foreach (UserProfileCard profile in profiles)
                                {
                                    bool isDefault = defaultProfile == profile.Type;
                                    <button type="button" role="radio" aria-checked="@(isDefault ? "true" : "false")"
                                            @onclick="() => SetDefaultProfileAsync(profile.Type)"
                                            disabled="@(isSavingDefault || isGhostMode)"
                                            class="px-4 py-1.5 rounded-full text-sm font-semibold transition-colors disabled:cursor-not-allowed @(isDefault ? "bg-accent-600 text-white shadow-md shadow-accent-800/40" : "text-text-muted hover:text-text-default disabled:opacity-50")">
                                        @GetTypeLabel(profile.Type)
                                    </button>
                                }
                            </div>
                        </div>
                        @if (isGhostMode)
                        {
                            <p class="text-sm text-text-muted mt-3">V režimu ducha výchozí profil změnit nelze.</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(defaultProfileErrorMessage))
                        {
                            <p class="text-sm text-red-400 mt-3">@defaultProfileErrorMessage</p>
                        }
                    </section>
                }

                <section class="rounded-2xl border border-accent-800/40 bg-primary-950/40 p-6">
                    <div class="flex flex-wrap items-center justify-between gap-4">
                        <div>
                            <h3 class="text-lg font-bold text-text-default">Režim ducha</h3>
                            <p class="text-text-muted text-sm mt-1">
                                Jako duch procházíte web jako běžn@(grammaticalGender == GrammaticalGender.Feminine ? "á zákaznice" : "ý zákazník"),
                                nikdo vás neuvidí online a nezanecháte žádné stopy. Nemůžete ale psát, nakupovat ani hodnotit.
                            </p>
                        </div>
                        <button type="button" @onclick="ToggleGhostModeAsync" disabled="@isTogglingGhost"
                                class="px-4 py-2 rounded-lg font-semibold transition-colors disabled:opacity-50 @(isGhostMode ? "bg-accent-600 hover:bg-accent-700 text-white" : "bg-primary-800 hover:bg-primary-700 text-text-default")">
                            @(isGhostMode ? "Vypnout režim ducha" : "Zapnout režim ducha")
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(ghostErrorMessage))
                    {
                        <p class="text-sm text-red-400 mt-3">@ghostErrorMessage</p>
                    }
                </section>

                <section class="rounded-2xl border border-accent-800/40 bg-primary-950/40 p-6">
                    <h3 class="text-lg font-bold text-text-default">Účet</h3>
                    <div class="mt-4 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        <div>
                            <p class="text-xs text-text-muted">Uživatelské jméno</p>
                            <p class="text-text-default break-all">@username</p>
                        </div>
                        <div>
                            <p class="text-xs text-text-muted">E-mail</p>
                            <p class="text-text-default break-all">@email</p>
                        </div>
                        <div>
                            <p class="text-xs text-text-muted">ID uživatele</p>
                            <p class="text-text-default break-all">@userId</p>
                        </div>
                        <div>
                            <p class="text-xs text-text-muted">Přihlášení</p>
                            <p class="text-text-default">@authenticationType</p>
                        </div>
                    </div>
                </section>
            </div>
        }
    </div>
</div>


@if (isServiceFormOpen)
{
    @* Add / edit service popup. The image cropper opens on top of it. *@
    <div class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6" role="dialog" aria-modal="true"
         aria-labelledby="service-modal-title" @onkeydown="OnServiceModalKeyDown">
        <div class="absolute inset-0 bg-black/70 backdrop-blur-xs modal-fade-in" @onclick="CancelEditService"></div>

        <div class="relative w-full max-w-2xl max-h-[95vh] overflow-y-auto rounded-2xl border border-accent-700/50 bg-primary-950 shadow-2xl shadow-black/60 modal-pop-in">
            <header class="flex items-start justify-between gap-4 px-5 sm:px-6 pt-5">
                <h2 id="service-modal-title" class="text-xl font-bold text-text-default">
                    @(editingServiceId is null ? "Přidat službu" : "Upravit službu")
                </h2>
                <button type="button" @onclick="CancelEditService" aria-label="Zavřít" disabled="@isSavingService"
                        class="shrink-0 w-9 h-9 flex items-center justify-center rounded-full text-text-muted hover:text-text-default hover:bg-primary-800 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </header>

            <div class="px-5 sm:px-6 pt-4">
                @* Image: click it to pick a file, then crop it, same as the profile picture and banner. *@
                @{
                    string? shownServiceImage = newService.Image?.PreviewUrl
                                                ?? (removeServiceImage ? null : editingServiceImageUrl);
                }
                <label title="@(shownServiceImage is null ? "Vybrat obrázek" : "Změnit obrázek")"
                       class="group relative block w-full aspect-video overflow-hidden rounded-xl border border-accent-800/40 cursor-pointer focus-within:ring-2 focus-within:ring-accent-500">
                    @if (shownServiceImage is not null)
                    {
                        <img src="@shownServiceImage" alt="Obrázek služby" class="w-full h-full object-cover"/>
                    }
                    else
                    {
                        <div class="w-full h-full bg-linear-to-br from-accent-700/40 via-accent-900/30 to-primary-950"></div>
                    }
                    <span class="absolute inset-0 flex items-center justify-center gap-2 bg-black/55 text-white font-semibold transition-opacity @(shownServiceImage is null ? "" : "opacity-0 group-hover:opacity-100 group-focus-within:opacity-100")">
                        @CameraIcon
                        @(shownServiceImage is null ? "Vybrat obrázek" : "Změnit obrázek")
                    </span>
                    @if (shownServiceImage is not null)
                    {
                        @* Touch screens have no hover: show a small badge instead. *@
                        <span class="touch-only absolute right-2 bottom-2 w-9 h-9 items-center justify-center rounded-full bg-black/60 text-white">
                            @CameraIcon
                        </span>
                    }
                    @* A new key after every pick/close lets the same file be picked again. *@
                    <InputFile @key="serviceFormKey" @ref="serviceImageInput" OnChange="OnServiceImagePicked"
                               accept="image/png,image/jpeg,image/webp" class="sr-only" aria-label="Obrázek služby"/>
                </label>
                <div class="mt-2 flex flex-wrap items-center justify-between gap-2">
                    <p class="text-xs text-text-muted">Poměr 16 : 9, ideálně aspoň 1280 × 720 px. JPG, PNG nebo WebP do 10 MB.</p>
                    @if (newService.Image is not null)
                    {
                        <button type="button" @onclick="() => newService.Image = null"
                                class="text-sm text-red-300 hover:underline">
                            Zrušit výběr
                        </button>
                    }
                    else if (editingServiceImageUrl is not null && !removeServiceImage)
                    {
                        <button type="button" @onclick="() => removeServiceImage = true"
                                class="text-sm text-red-300 hover:underline">
                            Odebrat obrázek
                        </button>
                    }
                    else if (editingServiceImageUrl is not null)
                    {
                        <span class="text-sm text-text-muted">
                            Obrázek bude odebrán.
                            <button type="button" @onclick="() => removeServiceImage = false"
                                    class="text-accent-300 hover:underline">
                                Vrátit
                            </button>
                        </span>
                    }
                </div>

                <div class="mt-4 grid sm:grid-cols-2 gap-3">
                    <input @ref="serviceNameInput" @bind="newService.Name" placeholder="Název služby"
                           maxlength="100"
                           class="w-full rounded-lg bg-primary-900 border border-accent-800/70 px-3 py-2 text-text-default"/>
                    <input @bind="newService.Category" placeholder="Kategorie" maxlength="50"
                           class="w-full rounded-lg bg-primary-900 border border-accent-800/70 px-3 py-2 text-text-default"/>
                    <input @bind="newService.PriceString" placeholder="Cena v celých Goinech (např. 199)" inputmode="numeric"
                           class="w-full rounded-lg bg-primary-900 border border-accent-800/70 px-3 py-2 text-text-default"/>
                    <input @bind="newService.PriceSuffix" @bind:event="oninput"
                           placeholder="Za jednotku (nepovinné, např. / hodina)" maxlength="20"
                           class="w-full rounded-lg bg-primary-900 border border-accent-800/70 px-3 py-2 text-text-default"/>
                </div>

                @* Game, rank and play style come from the curated GameCatalog so the Služby filters can rely on them. *@
                <div class="mt-3 grid sm:grid-cols-2 gap-3">
                    <select @bind="newService.GameKey" @bind:after="OnServiceGameChanged" aria-label="Hra"
                            class="w-full rounded-lg bg-primary-900 border border-accent-800/70 px-3 py-2 text-text-default">
                        <option value="">Bez konkrétní hry</option>
                        @foreach (Game game in GameCatalog.All)
                        {
                            <option value="@game.Key">@game.Name</option>
                        }
                    </select>
                    @if (GameCatalog.Find(newService.GameKey) is { HasRanks: true } selectedGame)
                    {
                        <select @bind="newService.RankKey" aria-label="Rank"
                                class="w-full rounded-lg bg-primary-900 border border-accent-800/70 px-3 py-2 text-text-default">
                            <option value="">Rank (nepovinné)</option>
                            @foreach (GameRank rank in selectedGame.Ranks)
                            {
                                <option value="@rank.Key">@rank.Name</option>
                            }
                        </select>
                    }
                </div>

                @if (!string.IsNullOrEmpty(newService.GameKey))
                {
                    <div class="mt-3 flex flex-wrap items-center gap-2" role="group" aria-label="Styl hraní">
                        <span class="text-sm text-text-muted">Hraji:</span>
                        <button type="button" @onclick="() => TogglePlayStyle(PlayStyles.Competitive)"
                                aria-pressed="@newService.PlayStyles.HasFlag(PlayStyles.Competitive)"
                                class="@PresetChipClass(newService.PlayStyles.HasFlag(PlayStyles.Competitive))">
                            Kompetitivně
                        </button>
                        <button type="button" @onclick="() => TogglePlayStyle(PlayStyles.Casual)"
                                aria-pressed="@newService.PlayStyles.HasFlag(PlayStyles.Casual)"
                                class="@PresetChipClass(newService.PlayStyles.HasFlag(PlayStyles.Casual))">
                            Pro zábavu
                        </button>
                    </div>
                }

                @* Price unit presets; the text field above stays editable for anything custom. *@
                <div class="mt-3 flex flex-wrap items-center gap-2" role="group" aria-label="Předvolby jednotky ceny">
                    <span class="text-sm text-text-muted">Účtovat:</span>
                    @{ PriceUnitPreset activePreset = ActivePriceUnitPreset; }
                    <button type="button" @onclick="() => TogglePriceUnitPreset(PriceUnitPreset.PerHour)"
                            aria-pressed="@(activePreset == PriceUnitPreset.PerHour)"
                            class="@PresetChipClass(activePreset == PriceUnitPreset.PerHour)">
                        Za hodinu
                    </button>
                    <button type="button" @onclick="() => TogglePriceUnitPreset(PriceUnitPreset.PerService)"
                            aria-pressed="@(activePreset == PriceUnitPreset.PerService)"
                            class="@PresetChipClass(activePreset == PriceUnitPreset.PerService)">
                        Za službu
                    </button>
                    <button type="button" @onclick="() => TogglePriceUnitPreset(PriceUnitPreset.PerServiceWithLimit)"
                            aria-pressed="@(activePreset == PriceUnitPreset.PerServiceWithLimit)"
                            class="@PresetChipClass(activePreset == PriceUnitPreset.PerServiceWithLimit)">
                        Za službu s časovým limitem
                    </button>
                    @if (activePreset == PriceUnitPreset.PerServiceWithLimit)
                    {
                        <label class="flex items-center gap-2 text-sm">
                            <span class="text-text-muted">max.</span>
                            <input type="number" min="1" max="@MaxServiceTimeLimitMinutes" step="1"
                                   @bind="ServiceTimeLimitMinutes"
                                   class="w-20 rounded-lg bg-primary-900 border border-accent-800/70 px-2 py-1 text-text-default"/>
                            <span class="text-text-muted">min</span>
                        </label>
                    }
                </div>

                <textarea @bind="newService.Description" rows="3" placeholder="Krátký popis"
                          class="mt-3 w-full rounded-lg bg-primary-900 border border-accent-800/70 px-3 py-2 text-text-default"></textarea>
            </div>

            @if (!string.IsNullOrWhiteSpace(serviceErrorMessage))
            {
                <p class="px-5 sm:px-6 mt-3 text-sm text-red-300" role="alert">@serviceErrorMessage</p>
            }

            <footer class="sticky bottom-0 mt-5 flex items-center justify-end gap-3 px-5 sm:px-6 py-4 border-t border-accent-800/40 bg-primary-950/95 backdrop-blur-xs">
                <button type="button" @onclick="CancelEditService" disabled="@isSavingService"
                        class="px-4 py-2 rounded-lg font-semibold bg-primary-800 hover:bg-primary-700 text-text-default transition-colors disabled:opacity-50">
                    Zrušit
                </button>
                <button type="button" @onclick="SaveServiceAsync" disabled="@isSavingService"
                        class="min-w-28 px-4 py-2 rounded-lg font-semibold bg-accent-600 hover:bg-accent-700 text-white shadow-lg shadow-accent-900/40 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                    @(isSavingService ? "Ukládáme…" : editingServiceId is null ? "Přidat službu" : "Uložit změny")
                </button>
            </footer>
        </div>
    </div>
}

@if (cropTarget == CropTarget.Service)
{
    <ImageCropperModal FileInput="cropFileInput"
                       Title="Upravit obrázek služby"
                       AspectRatio="@ServiceImageAspectRatio"
                       RecommendedMinWidth="800"
                       PreviewTemplate="ServiceCropPreview"
                       OnSave="SaveCroppedImageAsync"
                       OnClose="CloseCropper"/>
}
else if (cropTarget is { } target)
{
    bool isBanner = target == CropTarget.Banner;
    <ImageCropperModal FileInput="cropFileInput"
                       Title="@(isBanner ? "Upravit banner" : "Upravit profilovou fotku")"
                       Round="@(!isBanner)"
                       AspectRatio="@(isBanner ? 4.0 : 1.0)"
                       RecommendedMinWidth="@(isBanner ? 1200 : 256)"
                       PreviewName="@selectedProfile?.DisplayName"
                       PreviewAvatarUrl="@selectedProfile?.ProfileImageUrl"
                       OnSave="SaveCroppedImageAsync"
                       OnClose="CloseCropper"/>
}

@code {
    private const string UnknownValue = "Není k dispozici";

    private bool isLoading = true;
    private string? errorMessage;
    private string? createErrorMessage;

    private string username = UnknownValue;
    private string email = UnknownValue;
    private string userId = UnknownValue;
    private string authenticationType = UnknownValue;
    private Guid currentUserId;
    private GrammaticalGender grammaticalGender;
    private bool isGhostMode;
    private ProfileType defaultProfile = ProfileType.Customer;
    private bool isSavingDefault;
    private string? defaultProfileErrorMessage;
    private bool isTogglingGhost;
    private string? ghostErrorMessage;

    private List<UserProfileCard> profiles = new();
    private UserProfileCard? selectedProfile;

    private bool showCreatePanel;
    private List<ProfileType> availableTypes = new();
    private ProfileType newProfileType;
    private string newDisplayName = string.Empty;
    private string? newCustomerImageDataUrl;
    private string? customerImageErrorMessage;
    private string? updateImageErrorMessage;
    private string? updateImageSuccessMessage;

    private const long CustomerImageMaxSizeBytes = 2 * 1024 * 1024;

    private bool CanAddProfile => availableTypes.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthenticationState authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            ClaimsPrincipal user = authState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                string returnUrl = Uri.EscapeDataString("/profile");
                NavigationManager.NavigateTo($"/login?ReturnUrl={returnUrl}", true);
                return;
            }

            username = GetClaimValue(
                user,
                ClaimTypes.Name,
                JwtRegisteredClaimNames.UniqueName,
                "unique_name");

            email = GetClaimValue(
                user,
                ClaimTypes.Email,
                JwtRegisteredClaimNames.Email,
                "email");

            userId = GetClaimValue(
                user,
                ClaimTypes.NameIdentifier,
                JwtRegisteredClaimNames.Sub,
                "sub");

            if (!Guid.TryParse(userId, out currentUserId))
            {
                errorMessage = "Nepodařilo se zjistit vaše ID uživatele.";
                return;
            }

            authenticationType = user.Identity.AuthenticationType ?? UnknownValue;

            ActiveProfiles.Changed += OnActiveProfileChanged;
            await LoadProfilesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Při načítání profilu nastala neočekávaná chyba: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetClaimValue(ClaimsPrincipal principal, params string[] claimTypes)
    {
        foreach (string claimType in claimTypes)
        {
            string? claimValue = principal.FindFirst(claimType)?.Value;
            if (!string.IsNullOrWhiteSpace(claimValue))
            {
                return claimValue;
            }
        }

        return UnknownValue;
    }

    private static string BuildInitials(string value)
    {
        if (string.IsNullOrWhiteSpace(value) || value == UnknownValue)
        {
            return "?";
        }

        string[] parts = value.Split(new[] { ' ', '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return value[..1].ToUpperInvariant();
        }

        if (parts.Length == 1)
        {
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        }

        return string.Concat(parts[0][0], parts[1][0]).ToUpperInvariant();
    }

    /// <summary>Genitive of the player role for the current user: "hráče" or "hráčky".</summary>
    private string PlayerGenitive => grammaticalGender == GrammaticalGender.Feminine ? "hráčky" : "hráče";

    private string GetTypeLabel(ProfileType type)
    {
        return CzechLabels.Role(type, grammaticalGender);
    }

    private static bool RequiresDisplayName(ProfileType type)
    {
        return true;
    }

    private void SelectProfile(ProfileType type)
    {
        ShowProfile(type);

        // The tabs and the switch in the top bar always agree. In ghost mode the switch stays on Zákazník,
        // but the page can still show the player profile.
        ActiveProfiles.SetActive(type);
    }

    private void ShowProfile(ProfileType type)
    {
        if (selectedProfile?.Type == type)
        {
            return;
        }

        selectedProfile = profiles.FirstOrDefault(p => p.Type == type) ?? selectedProfile;
        if (selectedProfile is not null && selectedProfile.Type == ProfileType.Player)
        {
            _ = LoadAssociateDetailsAsync(selectedProfile.ProfileId);
        }
    }

    private void OnActiveProfileChanged()
    {
        _ = InvokeAsync(() =>
        {
            ShowProfile(ActiveProfiles.Active);
            StateHasChanged();
        });
    }

    private async Task SetDefaultProfileAsync(ProfileType type)
    {
        if (type == defaultProfile || isSavingDefault)
        {
            return;
        }

        defaultProfileErrorMessage = null;
        isSavingDefault = true;
        try
        {
            Result result = await SetDefaultProfileHandler.Handle(new SetDefaultProfileCommand
            {
                UserId = currentUserId,
                Profile = type,
            });

            if (result.IsFailure)
            {
                defaultProfileErrorMessage = result.Error!.Message;
                return;
            }

            defaultProfile = type;
        }
        finally
        {
            isSavingDefault = false;
        }
    }

    public void Dispose()
    {
        ActiveProfiles.Changed -= OnActiveProfileChanged;
    }

    private void OpenCreatePanel()
    {
        createErrorMessage = null;
        customerImageErrorMessage = null;
        availableTypes = GetMissingTypes(profiles);
        if (availableTypes.Count == 0)
        {
            return;
        }

        newProfileType = availableTypes[0];
        newDisplayName = string.Empty;
        newCustomerImageDataUrl = null;
        updateImageErrorMessage = null;
        updateImageSuccessMessage = null;
        showCreatePanel = true;
    }

    private void CloseCreatePanel()
    {
        showCreatePanel = false;
        createErrorMessage = null;
        customerImageErrorMessage = null;
        newCustomerImageDataUrl = null;
        updateImageErrorMessage = null;
        updateImageSuccessMessage = null;
    }

    private async Task OnCustomerImageSelected(InputFileChangeEventArgs e)
    {
        // Closing the file dialog without picking anything still fires a change with no file; keep the current pick.
        if (e.FileCount == 0)
        {
            return;
        }

        customerImageErrorMessage = null;
        updateImageSuccessMessage = null;
        newCustomerImageDataUrl = null;

        IBrowserFile file = e.File;

        if (file.Size > CustomerImageMaxSizeBytes)
        {
            customerImageErrorMessage = "Profilová fotka může mít nejvýše 2 MB.";
            return;
        }

        if (!IsSupportedImageType(file.ContentType))
        {
            customerImageErrorMessage = "Podporujeme jen obrázky JPG, PNG nebo WebP.";
            return;
        }

        await using Stream stream = file.OpenReadStream(CustomerImageMaxSizeBytes);
        using MemoryStream buffer = new();
        await stream.CopyToAsync(buffer);
        string base64 = Convert.ToBase64String(buffer.ToArray());
        newCustomerImageDataUrl = $"data:{file.ContentType};base64,{base64}";
    }

    private async Task CreateProfile()
    {
        createErrorMessage = null;

        if (newProfileType != ProfileType.Player)
        {
            // The customer profile is created at registration; only the player profile can be added here.
            createErrorMessage = "Přidat lze pouze profil hráče.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newDisplayName))
        {
            createErrorMessage = "Vyplňte přezdívku.";
            return;
        }

        Result<Guid> result = await CreatePlayerProfileHandler.Handle(new CreatePlayerProfileCommand
        {
            UserId = currentUserId,
            DisplayName = newDisplayName,
        });

        if (result.IsFailure)
        {
            createErrorMessage = result.Error!.Message;
            return;
        }

        await LoadProfilesAsync(force: true);
        SelectProfile(ProfileType.Player);
        showCreatePanel = false;
        newDisplayName = string.Empty;
        newCustomerImageDataUrl = null;
        customerImageErrorMessage = null;
    }

    private async Task ToggleGhostModeAsync()
    {
        ghostErrorMessage = null;
        isTogglingGhost = true;
        try
        {
            Result result = await SetGhostModeHandler.Handle(new SetGhostModeCommand
            {
                UserId = currentUserId,
                Enabled = !isGhostMode,
            });

            if (result.IsFailure)
            {
                ghostErrorMessage = result.Error!.Message;
                return;
            }

            // Reload so the top-bar switch hides/shows and falls back to Zákazník for a ghost.
            await LoadProfilesAsync(force: true);
        }
        finally
        {
            isTogglingGhost = false;
        }
    }

    private async Task LoadProfilesAsync(bool force = false)
    {
        // Shared with the top-bar switch, which loads the same data at the same time on this circuit.
        await ActiveProfiles.LoadAsync(currentUserId, force);
        if (ActiveProfiles.View is not { } view)
        {
            errorMessage = "Profily se nepodařilo načíst.";
            return;
        }

        grammaticalGender = view.GrammaticalGender;
        isGhostMode = view.IsGhostMode;
        defaultProfile = view.DefaultProfile;

        profiles = new List<UserProfileCard>();
        if (view.Customer is not null)
        {
            profiles.Add(new UserProfileCard
            {
                ProfileId = view.Customer.ProfileId,
                Type = ProfileType.Customer,
                DisplayName = view.Customer.DisplayName,
                ProfileImageUrl = ImageUrls.For(view.Customer.ImageId),
            });
        }

        if (view.Player is not null)
        {
            profiles.Add(new UserProfileCard
            {
                ProfileId = view.Player.ProfileId,
                Type = ProfileType.Player,
                DisplayName = view.Player.DisplayName,
                ProfileImageUrl = ImageUrls.For(view.Player.ImageId),
            });
        }

        // Profiles were rebuilt, so re-resolve the selection against the new list.
        ProfileType show = selectedProfile?.Type ?? ActiveProfiles.Active;
        selectedProfile = null;
        ShowProfile(profiles.Any(p => p.Type == show) ? show : ProfileType.Customer);

        availableTypes = GetMissingTypes(profiles);

        if (availableTypes.Count > 0)
        {
            newProfileType = availableTypes[0];
        }

        showCreatePanel = false;
    }

    private static List<ProfileType> GetMissingTypes(IReadOnlyCollection<UserProfileCard> currentProfiles)
    {
        HashSet<ProfileType> existing = currentProfiles.Select(p => p.Type).ToHashSet();
        List<ProfileType> allTypes = new() { ProfileType.Customer, ProfileType.Player };
        return allTypes.Where(type => !existing.Contains(type)).ToList();
    }

    private static bool IsSupportedImageType(string? contentType)
    {
        return contentType is "image/png" or "image/jpeg" or "image/jpg" or "image/pjpeg" or "image/webp";
    }

    // --- Associate management helper state ---
    private PlayerProfileDto? associateDetails;
    private bool isSavingService;
    private Guid? editingServiceId;
    private string? editingServiceImageUrl;
    private bool removeServiceImage;
    private Guid? deletingServiceId;
    private int serviceFormKey;
    private string? serviceSuccessMessage;
    private ElementReference serviceNameInput;
    private bool isServiceFormOpen;
    private bool focusServiceName;
    private string? bannerErrorMessage;

    private ServiceCreateModel newService = new();
    private string? serviceErrorMessage;

    // Preset price units. All must fit PlayerService.PriceUnitMaxLength (20):
    // "/ služba, do 999 min" is exactly 20 characters, hence the 999 cap.
    private const string PerHourUnit = "/ hodina";
    private const string PerServiceUnit = "/ služba";
    private const string TimeLimitUnitPrefix = "/ služba, do ";
    private const string TimeLimitUnitSuffix = " min";
    private const int DefaultServiceTimeLimitMinutes = 60;
    private const int MaxServiceTimeLimitMinutes = 999;

    private enum PriceUnitPreset
    {
        None,
        PerHour,
        PerService,
        PerServiceWithLimit,
        Custom,
    }

    /// <summary>The preset matching the current unit text, so the chips also light up for edited services.</summary>
    private PriceUnitPreset ActivePriceUnitPreset => newService.PriceSuffix.Trim() switch
    {
        "" => PriceUnitPreset.None,
        PerHourUnit => PriceUnitPreset.PerHour,
        PerServiceUnit => PriceUnitPreset.PerService,
        var unit when TryParseTimeLimit(unit, out _) => PriceUnitPreset.PerServiceWithLimit,
        _ => PriceUnitPreset.Custom,
    };

    private int ServiceTimeLimitMinutes
    {
        get => TryParseTimeLimit(newService.PriceSuffix.Trim(), out int minutes) ? minutes : DefaultServiceTimeLimitMinutes;
        set => newService.PriceSuffix = FormatTimeLimitUnit(value);
    }

    private void TogglePriceUnitPreset(PriceUnitPreset preset)
    {
        if (ActivePriceUnitPreset == preset)
        {
            newService.PriceSuffix = string.Empty;
            return;
        }

        newService.PriceSuffix = preset switch
        {
            PriceUnitPreset.PerHour => PerHourUnit,
            PriceUnitPreset.PerService => PerServiceUnit,
            PriceUnitPreset.PerServiceWithLimit => FormatTimeLimitUnit(DefaultServiceTimeLimitMinutes),
            _ => string.Empty,
        };
    }

    private static string FormatTimeLimitUnit(int minutes) =>
        $"{TimeLimitUnitPrefix}{Math.Clamp(minutes, 1, MaxServiceTimeLimitMinutes)}{TimeLimitUnitSuffix}";

    private static bool TryParseTimeLimit(string unit, out int minutes)
    {
        minutes = 0;
        return unit.Length > TimeLimitUnitPrefix.Length + TimeLimitUnitSuffix.Length
               && unit.StartsWith(TimeLimitUnitPrefix, StringComparison.Ordinal)
               && unit.EndsWith(TimeLimitUnitSuffix, StringComparison.Ordinal)
               && int.TryParse(
                   unit.AsSpan(TimeLimitUnitPrefix.Length, unit.Length - TimeLimitUnitPrefix.Length - TimeLimitUnitSuffix.Length),
                   System.Globalization.NumberStyles.None,
                   System.Globalization.CultureInfo.InvariantCulture,
                   out minutes)
               && minutes is >= 1 and <= MaxServiceTimeLimitMinutes;
    }

    private void OnServiceGameChanged()
    {
        // Ranks belong to one game, so a new game starts without a rank; offer both play styles by default.
        newService.RankKey = string.Empty;
        newService.PlayStyles = string.IsNullOrEmpty(newService.GameKey) ? PlayStyles.None : PlayStyles.Both;
    }

    private void TogglePlayStyle(PlayStyles style)
    {
        newService.PlayStyles ^= style;
    }

    private static string PresetChipClass(bool active) => active
        ? "px-3 py-1 rounded-full text-sm font-semibold bg-accent-600 text-white transition-colors"
        : "px-3 py-1 rounded-full text-sm font-semibold bg-primary-800 hover:bg-primary-700 text-text-default transition-colors";

    private record ServiceCreateModel
    {
        public string Name { get; set; } = string.Empty;

        public string Description { get; set; } = string.Empty;

        public string Category { get; set; } = string.Empty;

