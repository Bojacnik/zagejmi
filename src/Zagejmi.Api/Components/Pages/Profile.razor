    private async Task LoadProfilesAsync()
    {
        HttpClient readApi = CreateReadApiClient();
        HttpResponseMessage response = await readApi.GetAsync($"api/v1/read/users/{currentUserId}/profiles");
        if (!response.IsSuccessStatusCode)
        {
            string responseText = await response.Content.ReadAsStringAsync();
            errorMessage = ExtractErrorMessage(response.StatusCode, responseText);
            return;
        }

        IReadOnlyList<UserProfileDto>? result = await response.Content.ReadFromJsonAsync<IReadOnlyList<UserProfileDto>>();
        profiles = result?.Select(MapProfile).ToList() ?? [];
        selectedProfile = profiles.FirstOrDefault();
        if (selectedProfile is not null && selectedProfile.Type == ProfileType.Associate)
        {
            _ = LoadAssociateDetailsAsync(selectedProfile.ProfileId);
        }

        availableTypes = GetMissingTypes(profiles);

        if (availableTypes.Count > 0)
        {
            newProfileType = availableTypes[0];
        }

        showCreatePanel = profiles.Count == 0;
    }

    private UserProfileCard MapProfile(UserProfileDto dto)
    {
        return new UserProfileCard
        {
            ProfileId = dto.ProfileId,
            Type = FromWriteProfileType(dto.ProfileType),
            DisplayName = dto.DisplayName,
            ProfileImageUrl = ResolveProfileImageUrl(dto.ProfileImageUrl),
        };
    }

    private string? ResolveProfileImageUrl(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return null;
        }

        if (Uri.TryCreate(imageUrl, UriKind.Absolute, out _)
            || imageUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
        {
            return imageUrl;
        }

        Uri? writeApiBaseUri = HttpClientFactory.CreateClient("WriteAPI").BaseAddress;
        if (writeApiBaseUri != null)
        {
            return new Uri(writeApiBaseUri, imageUrl).ToString();
        }

        string? writeBaseAddress = Configuration["WriteApi:BaseAddress"];
        if (string.IsNullOrWhiteSpace(writeBaseAddress))
        {
            return imageUrl;
        }

        return new Uri(new Uri(writeBaseAddress), imageUrl).ToString();
    }

    private static List<ProfileType> GetMissingTypes(IReadOnlyCollection<UserProfileCard> currentProfiles)
    {
        HashSet<ProfileType> existing = currentProfiles.Select(p => p.Type).ToHashSet();
        List<ProfileType> allTypes = [ProfileType.Customer, ProfileType.Associate, ProfileType.Anon];
        return allTypes.Where(type => !existing.Contains(type)).ToList();
    }

    private static string ToWriteProfileType(ProfileType type)
    {
        return type switch
        {
            ProfileType.Anon => "Anonymous",
            _ => type.ToString(),
        };
    }

    private static ProfileType FromWriteProfileType(string type)
    {
        if (string.Equals(type, "Anonymous", StringComparison.OrdinalIgnoreCase))
        {
            return ProfileType.Anon;
        }

        return Enum.TryParse(type, true, out ProfileType parsed)
            ? parsed
            : ProfileType.Anon;
    }

    private static string ExtractErrorMessage(HttpStatusCode statusCode, string body)
    {
        if (string.IsNullOrWhiteSpace(body))
        {
            return $"Request failed ({(int)statusCode}).";
        }

        try
        {
            ValidationErrorResponse? parsed = JsonSerializer.Deserialize<ValidationErrorResponse>(
                body,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (parsed?.Errors.Count > 0)
            {
                return parsed.Errors[0];
            }
        }
        catch
        {
            // Fallback to plain response body.
        }

        return body;
    }

    private HttpClient CreateWriteApiClient()
    {
        HttpClient client = HttpClientFactory.CreateClient("WriteAPI");

        if (!string.IsNullOrWhiteSpace(accessToken))
        {
            client.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", accessToken);
        }

        return client;
    }

    private HttpClient CreateReadApiClient()
    {
        HttpClient client = HttpClientFactory.CreateClient();
        client.BaseAddress = new Uri(NavigationManager.BaseUri);

        if (!string.IsNullOrWhiteSpace(accessToken))
        {
            client.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", accessToken);
        }

        return client;
    }

    private static bool IsSupportedImageType(string? contentType)
    {
        return contentType is "image/png" or "image/jpeg" or "image/jpg" or "image/pjpeg";
    }

