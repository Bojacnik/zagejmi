    /// <summary>
    ///     Hint and messages under the profile picture.
    /// </summary>
    private RenderFragment PictureControls => @<div class="mt-3 flex flex-col items-center text-center">
        <p class="text-xs text-text-muted">Kliknutím na fotku ji změníte. JPG, PNG nebo WebP do 10 MB.</p>
        @if (!string.IsNullOrWhiteSpace(updateImageErrorMessage))
        {
            <p class="text-sm text-red-300 mt-2">@updateImageErrorMessage</p>
        }
        else if (!string.IsNullOrWhiteSpace(updateImageSuccessMessage))
        {
            <p class="text-sm text-green-300 mt-2">@updateImageSuccessMessage</p>
        }
    </div>;

    private Task OnPicturePicked(InputFileChangeEventArgs e)
    {
        return OnImagePicked(e, CropTarget.Picture);
    }

    private Task OnBannerPicked(InputFileChangeEventArgs e)
    {
        return OnImagePicked(e, CropTarget.Banner);
    }

    private Task OnServiceImagePicked(InputFileChangeEventArgs e)
    {
        serviceErrorMessage = null;
        serviceSuccessMessage = null;
        return OnImagePicked(e, CropTarget.Service);
    }

    /// <summary>
    ///     How a service card will look with the cropped picture (filled in live by the cropper).
    /// </summary>
    private RenderFragment ServiceCropPreview => @<div class="mt-3 mx-auto max-w-xs overflow-hidden rounded-lg border border-accent-800/40 bg-primary-950">
        <div data-crop-preview class="crop-preview w-full aspect-video"><img alt=""/></div>
        <div class="px-3 py-2">
            <p class="font-bold text-text-default truncate">@(string.IsNullOrWhiteSpace(newService.Name) ? "Název služby" : newService.Name)</p>
            @if (!string.IsNullOrWhiteSpace(newService.Category))
            {
                <p class="text-xs text-text-muted truncate">@newService.Category</p>
            }
        </div>
    </div>;

    private Task OnImagePicked(InputFileChangeEventArgs e, CropTarget target)
    {
        // Closing the file dialog without picking anything still fires a change with no file.
        if (e.FileCount == 0)
        {
            ResetFileInputs();
            return Task.CompletedTask;
        }

        updateImageErrorMessage = null;
        updateImageSuccessMessage = null;
        bannerErrorMessage = null;
        bannerSuccessMessage = null;

        IBrowserFile file = e.File;
        string? error = !IsSupportedImageType(file.ContentType)
            ? "Podporujeme jen obrázky JPG, PNG nebo WebP."
            : file.Size > ImageUploader.MaxUploadBytes
                ? "Obrázek může mít nejvýše 10 MB."
                : null;

        InputFile? input = target switch
        {
            CropTarget.Banner => bannerInput,
            CropTarget.Service => serviceImageInput,
            _ => pictureInput,
        };
        if (error is not null || input?.Element is not { } element)
        {
            switch (target)
            {
                case CropTarget.Banner:
                    bannerErrorMessage = error;
                    break;
                case CropTarget.Service:
                    serviceErrorMessage = error;
                    break;
                default:
                    updateImageErrorMessage = error;
                    break;
            }

            ResetFileInputs();
            return Task.CompletedTask;
        }

        // The cropper shows the file straight from the browser; meanwhile the bytes travel to the server.
        cropFileInput = element;
        cropFileBytes = ReadAllBytesAsync(file);
        cropTarget = target;
        return Task.CompletedTask;
    }

    private static async Task<byte[]> ReadAllBytesAsync(IBrowserFile file)
    {
        await using Stream stream = file.OpenReadStream(ImageUploader.MaxUploadBytes);
        using MemoryStream buffer = new((int)file.Size);
        await stream.CopyToAsync(buffer);
        return buffer.ToArray();
    }

    private async Task<string?> SaveCroppedImageAsync(CropRegion crop)
    {
        if (cropTarget is not { } target || cropFileBytes is null || selectedProfile is null)
        {
            return "Obrázek se nepodařilo uložit. Zkuste to prosím znovu.";
        }

        byte[] bytes;
        try
        {
            bytes = await cropFileBytes;
        }
        catch (Exception)
        {
            return "Soubor se nepodařilo načíst. Zkuste ho prosím vybrat znovu.";
        }

        if (target == CropTarget.Service)
        {
            return await KeepServiceImageAsync(bytes, crop);
        }

        await using MemoryStream content = new(bytes, writable: false);
        Result<Guid> result = target == CropTarget.Banner
            ? await SetPlayerBannerHandler.Handle(new SetPlayerBannerCommand
            {
                UserId = currentUserId,
                Content = content,
                Crop = crop,
            })
            : await SetProfileImageHandler.Handle(new SetProfileImageCommand
            {
                UserId = currentUserId,
                Profile = selectedProfile.Type,
                Content = content,
                Crop = crop,
            });

        if (result.IsFailure)
        {
            return result.Error!.Message;
        }

        if (target == CropTarget.Banner)
        {
            bannerSuccessMessage = "Banner je změněný.";
        }
        else
        {
            // Refresh the cards (and the top bar) with the new picture.
            await LoadProfilesAsync(force: true);
            updateImageSuccessMessage = "Profilová fotka je změněná.";
        }

        if (selectedProfile.Type == ProfileType.Player)
        {
            await LoadAssociateDetailsAsync(selectedProfile.ProfileId);
        }

        return null;
    }

    /// <summary>
    ///     Remembers the cropped service image for when the service form is saved and makes a small preview of it.
    /// </summary>
    private async Task<string?> KeepServiceImageAsync(byte[] bytes, CropRegion crop)
    {
        await using MemoryStream content = new(bytes, writable: false);
        Result<ProcessedImage> thumbnail = await ImageProcessor.ProcessAsync(content, ServiceThumbnailLimits, crop);
        if (thumbnail.IsFailure)
        {
            return thumbnail.Error!.Message;
        }

        ProcessedImage preview = thumbnail.Value;
        newService.Image = new PendingServiceImage(
            bytes,
            crop,
            $"data:{preview.ContentType};base64,{Convert.ToBase64String(preview.Content)}");
        removeServiceImage = false;
        return null;
    }

    private void CloseCropper()
    {
        cropTarget = null;
        cropFileBytes = null;
        ResetFileInputs();
    }

    /// <summary>
    ///     Re-creates the file inputs so picking the same file again still fires a change.
    /// </summary>
    private void ResetFileInputs()
    {
        pictureInputKey++;
        bannerInputKey++;
        serviceFormKey++;
    }

    private async Task LoadAssociateDetailsAsync(Guid profileId)
    {
        Result<PlayerDetail> result = await GetPlayerDetailHandler.Handle(profileId);
        if (result.IsFailure)
        {
            return;
        }

        PlayerDetail detail = result.Value;
        associateDetails = new PlayerProfileDto
        {
            ProfileId = detail.ProfileId,
            DisplayName = detail.DisplayName,
            Bio = detail.Description,
            GrammaticalGender = detail.GrammaticalGender,
            CreatedAt = detail.CreatedAt,
            ProfileImageUrl = ImageUrls.For(detail.ProfileImageId),
            BannerImageUrl = ImageUrls.For(detail.BannerImageId),
            Services = detail.Services
                .Select(svc => new ServiceDto
                {
                    ServiceId = svc.ServiceId,
                    Name = svc.Name,
                    Description = svc.Description,
                    Category = svc.Category,
                    GameKey = svc.GameKey,
                    RankKey = svc.RankKey,
                    PlayStyles = svc.PlayStyles,
                    Price = svc.Price,
                    PriceSuffix = svc.PriceUnit,
                    ImageUrl = ImageUrls.For(svc.ImageId),
                    IsAvailable = svc.IsAvailable,
                })
                .ToList(),
        };

        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveServiceAsync()
    {
        serviceErrorMessage = null;
        serviceSuccessMessage = null;
        deletingServiceId = null;

        if (selectedProfile is null || selectedProfile.Type != ProfileType.Player)
        {
            serviceErrorMessage = $"Nejdřív vyberte profil {PlayerGenitive}.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newService.Name))
        {
            serviceErrorMessage = "Vyplňte název služby.";
            return;
        }

        // Whole Goins only; cs-CZ users may type "1 000" with a (non-breaking) space as the thousands separator.
        long price = 0;
        if (!string.IsNullOrWhiteSpace(newService.PriceString)
            && !long.TryParse(
                newService.PriceString.Replace(" ", string.Empty).Replace("\u00A0", string.Empty),
                NumberStyles.AllowLeadingSign,
                CultureInfo.InvariantCulture,
                out price))
        {
            serviceErrorMessage = "Cena musí být celé číslo Goinů, např. 199.";
            return;
        }

        isSavingService = true;
        try
        {
            PendingServiceImage? picked = newService.Image;
            await using MemoryStream? image = picked is null ? null : new MemoryStream(picked.Content, writable: false);

            Result result = editingServiceId is { } serviceId
                ? await UpdatePlayerServiceHandler.Handle(new UpdatePlayerServiceCommand
                {
                    UserId = currentUserId,
                    ServiceId = serviceId,
                    Name = newService.Name,
                    Description = newService.Description,
                    Category = newService.Category,
                    GameKey = newService.GameKey,
                    RankKey = newService.RankKey,
                    PlayStyles = newService.PlayStyles,
                    Price = price,
                    PriceUnit = newService.PriceSuffix,
                    NewImage = image,
                    ImageCrop = picked?.Crop,
                    RemoveImage = removeServiceImage,
                })
                : await AddPlayerServiceHandler.Handle(new AddPlayerServiceCommand
                {
                    UserId = currentUserId,
                    Name = newService.Name,
                    Description = newService.Description,
                    Category = newService.Category,
                    GameKey = newService.GameKey,
                    RankKey = newService.RankKey,
                    PlayStyles = newService.PlayStyles,
                    Price = price,
                    PriceUnit = newService.PriceSuffix,
                    Image = image,
                    ImageCrop = picked?.Crop,
                });

            if (result.IsFailure)
            {
                serviceErrorMessage = result.Error!.Message;
                return;
            }

            serviceSuccessMessage = editingServiceId is null ? "Služba je přidaná." : "Změny jsou uložené.";
            ResetServiceForm();
            await LoadAssociateDetailsAsync(selectedProfile.ProfileId);
        }
        finally
        {
            isSavingService = false;
        }
    }

    private Task StartEditService(ServiceDto service)
    {
        serviceErrorMessage = null;
        serviceSuccessMessage = null;
        deletingServiceId = null;

        editingServiceId = service.ServiceId;
        editingServiceImageUrl = service.ImageUrl;
        removeServiceImage = false;
        serviceFormKey++;
        newService = new ServiceCreateModel
        {
            Name = service.Name,
            Category = service.Category ?? string.Empty,
            GameKey = service.GameKey ?? string.Empty,
            RankKey = service.RankKey ?? string.Empty,
            PlayStyles = service.PlayStyles,
            PriceString = service.Price.ToString(CultureInfo.InvariantCulture),
            PriceSuffix = service.PriceSuffix ?? string.Empty,
            Description = service.Description ?? string.Empty,
        };

        isServiceFormOpen = true;
        focusServiceName = true;
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusServiceName && isServiceFormOpen)
        {
            focusServiceName = false;
            await serviceNameInput.FocusAsync();
        }
    }

    private void OpenAddService()
    {
        serviceErrorMessage = null;
        serviceSuccessMessage = null;
        deletingServiceId = null;
        ResetServiceForm();
        isServiceFormOpen = true;
        focusServiceName = true;
    }

    private Task OnServiceModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CancelEditService();
        }

        return Task.CompletedTask;
    }

    private void CancelEditService()
    {
        if (isSavingService)
        {
            return;
        }

        serviceErrorMessage = null;
        serviceSuccessMessage = null;
        ResetServiceForm();
    }

    private void ResetServiceForm()
    {
        isServiceFormOpen = false;
        editingServiceId = null;
        editingServiceImageUrl = null;
        removeServiceImage = false;
        serviceFormKey++;
        newService = new ServiceCreateModel();
    }

    private async Task DeleteServiceAsync(Guid serviceId)
    {
        if (selectedProfile is null)
        {
            return;
        }

        serviceErrorMessage = null;
        serviceSuccessMessage = null;
        isSavingService = true;
        try
        {
            Result result = await DeletePlayerServiceHandler.Handle(new DeletePlayerServiceCommand
            {
                UserId = currentUserId,
                ServiceId = serviceId,
            });

            if (result.IsFailure)
            {
                serviceErrorMessage = result.Error!.Message;
                return;
            }

            if (editingServiceId == serviceId)
            {
                ResetServiceForm();
            }

            serviceSuccessMessage = "Služba je smazaná.";
            await LoadAssociateDetailsAsync(selectedProfile.ProfileId);
        }
        finally
        {
            deletingServiceId = null;
            isSavingService = false;
        }
    }

}