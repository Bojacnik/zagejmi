    /// <param name="PreviewUrl">A small already-cropped thumbnail as a data URL.</param>
    private sealed record PendingServiceImage(byte[] Content, CropRegion Crop, string PreviewUrl);

    private enum CropTarget
    {
        Picture,
        Banner,
        Service,
    }

    private const double ServiceImageAspectRatio = 16.0 / 9.0;

    // Small enough to send to the browser as a data URL, big enough for the form preview.
    private static readonly ImageLimits ServiceThumbnailLimits = new(480, 270, ServiceImageAspectRatio);

    private InputFile? serviceImageInput;

    private InputFile? pictureInput;
    private InputFile? bannerInput;
    private int pictureInputKey;
    private int bannerInputKey;
    private CropTarget? cropTarget;
    private ElementReference cropFileInput;
    private Task<byte[]>? cropFileBytes;
    private string? bannerSuccessMessage;

