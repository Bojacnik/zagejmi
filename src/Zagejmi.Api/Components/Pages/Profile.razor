@page "/profile"
@using System.IdentityModel.Tokens.Jwt
@using System.IO
@using System.Net
@using System.Net.Http.Headers
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Configuration
@using Zagejmi.Contracts.Commands
@using Zagejmi.Contracts.Dtos
@using Zagejmi.Read.Api.Models
@rendermode InteractiveServer
@attribute [Authorize]

@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Configuration

<PageTitle>Profile</PageTitle>

<div class="w-full max-w-6xl mx-auto py-8 px-4 sm:px-8">
    <div
        class="rounded-3xl border border-accent-800/40 bg-gradient-to-br from-primary-900/80 via-primary-950/80 to-primary-900/70 p-6 sm:p-8 shadow-2xl shadow-primary-950/50">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
            <div>
                <h1 class="text-4xl font-extrabold tracking-tight text-text-default">Profile Hub</h1>
                <p class="text-text-muted mt-2">Switch between your profiles, create missing ones, and manage identity
                    at a glance.</p>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="mt-8 text-center p-8 bg-primary-900/40 rounded-2xl border border-accent-700/40">
                <p class="text-text-muted animate-pulse">Loading profile...</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="mt-8 p-4 text-sm text-red-300 bg-red-900/20 border border-red-500/40 rounded-xl" role="alert">
                <h2 class="font-bold">Unable to load profile</h2>
                <p>@errorMessage</p>
            </div>
        }
        else
        {
            <div class="mt-8 space-y-6">
                <div class="rounded-2xl border border-accent-800/40 bg-primary-950/50 p-4">
                    <div class="flex flex-wrap items-center gap-3">
                        @foreach (UserProfileCard profile in profiles)
                        {
                            <button @onclick="() => SelectProfile(profile.Type)"
                                    class="px-4 py-2 rounded-full text-sm font-semibold transition-colors @(selectedProfile?.Type == profile.Type ? "bg-accent-600 text-white" : "bg-primary-900 text-text-muted hover:text-text-default hover:bg-primary-800")">
                                @GetTypeLabel(profile.Type)
                            </button>
                        }

                        @if (CanAddProfile)
                        {
                            <button @onclick="OpenCreatePanel"
                                    class="w-10 h-10 rounded-full border border-accent-600 text-accent-300 hover:bg-accent-700/20 transition-colors text-xl font-bold"
                                    aria-label="Create profile">
                                +
                            </button>
                        }
                    </div>
                </div>

                @if (showCreatePanel)
                {
                    <section class="rounded-2xl border border-accent-700/50 bg-primary-900/50 p-6">
                        <h2 class="text-2xl font-bold text-text-default">Create New Profile</h2>
                        <p class="text-text-muted mt-1">You can create one profile per type: Customer, Associate, and
                            Anon.</p>

                        <div class="grid sm:grid-cols-2 gap-4 mt-5">
                            <div>
                                <label class="block text-sm text-text-muted mb-2">Profile type</label>
                                <select @bind="newProfileType"
                                        class="w-full rounded-lg bg-primary-950 border border-accent-800/70 px-3 py-2 text-text-default">
                                    @foreach (ProfileType type in availableTypes)
                                    {
                                        <option value="@type">@GetTypeLabel(type)</option>
                                    }
                                </select>
                            </div>

                            @if (RequiresDisplayName(newProfileType))
                            {
                                <div>
                                    <label class="block text-sm text-text-muted mb-2">Display name</label>
                                    <input @bind="newDisplayName" maxlength="40"
                                           class="w-full rounded-lg bg-primary-950 border border-accent-800/70 px-3 py-2 text-text-default"
                                           placeholder="Enter display name"/>
                                </div>
                            }
                        </div>

                        @if (newProfileType == ProfileType.Customer)
                        {
                            <div class="mt-5">
                                <label class="block text-sm text-text-muted mb-2">Profile picture (PNG/JPEG, max 2
                                    MB)</label>
                                <InputFile OnChange="OnCustomerImageSelected" accept="image/png,image/jpeg"
                                           class="block w-full text-sm text-text-default file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-accent-700 file:text-white hover:file:bg-accent-600"/>
                                @if (!string.IsNullOrWhiteSpace(customerImageErrorMessage))
                                {
                                    <p class="text-sm text-red-300 mt-2">@customerImageErrorMessage</p>
                                }
                                else if (!string.IsNullOrWhiteSpace(newCustomerImageDataUrl))
                                {
                                    <img src="@newCustomerImageDataUrl" alt="Customer profile preview"
                                         class="mt-3 h-20 w-20 rounded-full object-cover border border-accent-700/50"/>
                                }
                            </div>
                        }

                        <div class="flex items-center gap-3 mt-5">
                            <button @onclick="CreateProfile"
                                    class="px-4 py-2 rounded-lg font-semibold bg-accent-600 hover:bg-accent-700 text-white transition-colors">
                                Create Profile
                            </button>
                            <button @onclick="CloseCreatePanel"
                                    class="px-4 py-2 rounded-lg font-semibold bg-primary-800 hover:bg-primary-700 text-text-default transition-colors">
                                Cancel
                            </button>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(createErrorMessage))
                        {
                            <p class="text-sm text-red-300 mt-4">@createErrorMessage</p>
                        }
                    </section>
                }

                @if (selectedProfile is null)
                {
                    <div class="min-h-[45vh] grid place-items-center">
                        <section
                            class="w-full max-w-3xl rounded-2xl border border-dashed border-accent-700/50 bg-primary-950/40 p-10 text-center">
                            <h2 class="text-3xl font-bold text-text-default">No profile yet</h2>
                            <p class="text-text-muted mt-2 max-w-2xl mx-auto">Create your first profile to continue. You
                                can have up to three profile types: Customer, Associate, and Anon.</p>
                        </section>
                    </div>
                }
                else
                {
                    @switch (selectedProfile.Type)
                    {
                        case ProfileType.Customer:
                            <section class="grid lg:grid-cols-3 gap-6">
                                <div class="rounded-2xl border border-accent-700/50 bg-primary-950/60 p-6">
                                    @if (!string.IsNullOrWhiteSpace(selectedProfile.ProfileImageUrl))
                                    {
                                        <img src="@selectedProfile.ProfileImageUrl" alt="Customer profile picture"
                                             class="w-28 h-28 rounded-full object-cover border border-accent-700/50 mx-auto"/>
                                    }
                                    else
                                    {
                                        <div
                                            class="w-28 h-28 rounded-full bg-accent-700 text-text-default text-3xl font-bold flex items-center justify-center mx-auto">
                                            @BuildInitials(selectedProfile.DisplayName)
                                        </div>
                                    }
                                    <h3 class="text-2xl font-bold text-text-default text-center mt-4">@selectedProfile.DisplayName</h3>
                                    <p class="text-text-muted text-center mt-1">Customer profile</p>
                                    <p class="text-xs text-text-muted text-center mt-4">Profile photo recommendation:
                                        square 1024 x 1024 px, JPEG/PNG, up to 2 MB.</p>

                                    <div class="mt-6 p-4 rounded-xl border border-accent-800/50 bg-primary-900/40">
                                        <label class="block text-sm font-medium text-text-muted mb-2">Change profile
                                            picture</label>
                                        <InputFile OnChange="OnExistingCustomerImageSelected"
                                                   accept="image/png,image/jpeg,image/jpg"
                                                   class="block w-full text-sm text-text-default file:mr-4 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-accent-700 file:text-white hover:file:bg-accent-600"/>

                                        @if (!string.IsNullOrWhiteSpace(pendingExistingCustomerImageDataUrl))
                                        {
                                            <div class="mt-3 flex items-center gap-3">
                                                <img src="@pendingExistingCustomerImageDataUrl"
                                                     alt="New customer profile preview"
                                                     class="h-16 w-16 rounded-full object-cover border border-accent-700/50"/>
                                                <span class="text-sm text-text-muted">New picture selected.</span>
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(updateImageErrorMessage))
                                        {
                                            <p class="text-sm text-red-300 mt-2">@updateImageErrorMessage</p>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(updateImageSuccessMessage))
                                        {
                                            <p class="text-sm text-green-300 mt-2">@updateImageSuccessMessage</p>
                                        }

                                        <button @onclick="UpdateCustomerPicture"
                                                disabled="@isUpdatingImage"
                                                class="mt-3 px-4 py-2 rounded-lg font-semibold bg-primary-800 hover:bg-primary-700 text-text-default transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                                            @(isUpdatingImage ? "Saving..." : "Save picture")
                                        </button>
                                    </div>
                                </div>
                                <div
                                    class="lg:col-span-2 rounded-2xl border border-accent-700/50 bg-primary-900/60 p-6">
                                    <h3 class="text-xl font-bold text-text-default">Customer Stats</h3>
                                    <p class="text-text-muted text-sm mt-1">Placeholders for future metrics.</p>
                                    <div class="mt-5 grid sm:grid-cols-3 gap-4">
                                        <div class="rounded-xl bg-primary-950/60 border border-accent-900/50 p-4">
                                            <p class="text-xs text-text-muted">Level</p>
                                            <p class="text-3xl font-bold text-accent-300">@selectedProfile.Stats.Level</p>
                                        </div>
                                        <div class="rounded-xl bg-primary-950/60 border border-accent-900/50 p-4">
                                            <p class="text-xs text-text-muted">Reputation</p>
                                            <p class="text-3xl font-bold text-accent-300">@selectedProfile.Stats.Reputation</p>
                                        </div>
                                        <div class="rounded-xl bg-primary-950/60 border border-accent-900/50 p-4">
                                            <p class="text-xs text-text-muted">Completed sessions</p>
                                            <p class="text-3xl font-bold text-accent-300">@selectedProfile.Stats.CompletedSessions</p>
                                        </div>
                                    </div>
                                </div>
                            </section>
                            break;
                        case ProfileType.Associate:
                            <section class="rounded-2xl border border-accent-700/50 bg-primary-900/60 p-6 space-y-4">
                                <h3 class="text-2xl font-bold text-text-default">Associate Profile</h3>
                                <p class="text-text-muted">Display name: <span
                                        class="text-text-default font-semibold">@selectedProfile.DisplayName</span></p>

                                @* Associate banner and profile image management *@
                                <div class="grid lg:grid-cols-3 gap-4">
                                    <div
                                        class="lg:col-span-1 rounded-xl bg-primary-950/60 border border-accent-900/50 p-4">
                                        <p class="text-xs text-text-muted">Profile picture</p>
                                        @if (!string.IsNullOrWhiteSpace(selectedProfile.ProfileImageUrl))
                                        {
                                            <img src="@selectedProfile.ProfileImageUrl" alt="Associate profile picture"
                                                 class="w-28 h-28 rounded-full object-cover border border-accent-700/50 mx-auto"/>
                                        }
                                        else
                                        {
                                            <div
                                                class="w-28 h-28 rounded-full bg-accent-700 text-text-default text-3xl font-bold flex items-center justify-center mx-auto">
                                                @BuildInitials(selectedProfile.DisplayName)
                                            </div>
                                        }

                                        <div class="mt-4">
                                            <label class="block text-sm font-medium text-text-muted mb-2">Change profile
                                                picture</label>
                                            <InputFile OnChange="OnExistingAssociateImageSelected"
                                                       accept="image/png,image/jpeg,image/jpg"
                                                       class="block w-full text-sm text-text-default file:mr-4 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-accent-700 file:text-white hover:file:bg-accent-600"/>

                                            @if (!string.IsNullOrWhiteSpace(pendingExistingAssociateImageDataUrl))
                                            {
                                                <div class="mt-3 flex items-center gap-3">
                                                    <img src="@pendingExistingAssociateImageDataUrl"
                                                         alt="New associate profile preview"
                                                         class="h-16 w-16 rounded-full object-cover border border-accent-700/50"/>
                                                    <span class="text-sm text-text-muted">New picture selected.</span>
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(updateImageErrorMessage))
                                            {
                                                <p class="text-sm text-red-300 mt-2">@updateImageErrorMessage</p>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(updateImageSuccessMessage))
                                            {
                                                <p class="text-sm text-green-300 mt-2">@updateImageSuccessMessage</p>
                                            }

                                            <button @onclick="UpdateAssociatePicture"
                                                    disabled="@isUpdatingImage"
                                                    class="mt-3 px-4 py-2 rounded-lg font-semibold bg-primary-800 hover:bg-primary-700 text-text-default transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                                                @(isUpdatingImage ? "Saving..." : "Save picture")
                                            </button>
                                        </div>
                                    </div>

                                    <div
                                        class="lg:col-span-2 rounded-xl bg-primary-950/60 border border-accent-900/50 p-4">
                                        <p class="text-xs text-text-muted">Banner image</p>

                                        @if (!string.IsNullOrWhiteSpace(pendingAssociateBannerDataUrl))
                                        {
                                            <img src="@pendingAssociateBannerDataUrl" alt="New banner preview"
                                                 class="w-full h-40 object-cover rounded-md border border-accent-700/50"/>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(associateDetails?.BannerImageUrl))
                                        {
                                            <img src="@associateDetails.BannerImageUrl" alt="Banner"
                                                 class="w-full h-40 object-cover rounded-md border border-accent-700/50"/>
                                        }
                                        else
                                        {
                                            <div
                                                class="w-full h-40 rounded-md bg-gradient-to-br from-accent-700/20 to-accent-900/10"></div>
                                        }

                                        <div class="mt-3 flex items-center gap-3">
                                            <InputFile OnChange="OnAssociateBannerSelected"
                                                       accept="image/png,image/jpeg"
                                                       class="block text-sm text-text-default file:mr-4 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-accent-700 file:text-white hover:file:bg-accent-600"/>
                                            <button @onclick="SaveAssociateBanner" disabled="@isSavingBanner"
                                                    class="px-4 py-2 rounded-lg font-semibold bg-primary-800 hover:bg-primary-700 text-text-default transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                                                @(isSavingBanner ? "Saving..." : "Save banner")
                                            </button>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(bannerErrorMessage))
                                        {
                                            <p class="text-sm text-red-300 mt-2">@bannerErrorMessage</p>
                                        }
                                    </div>
                                </div>

                                @* Services management panel *@
                                <div class="rounded-xl border border-accent-800/40 bg-primary-950/40 p-4">
                                    <div class="flex items-center justify-between">
                                        <h4 class="text-lg font-bold">Services
                                            (@(associateDetails?.Services?.Count ?? 0))</h4>
                                        <div class="text-sm text-text-muted">You can add up to 255 services.</div>
                                    </div>

                                    <div class="mt-4 space-y-3">
                                        @if (associateDetails?.Services is not null && associateDetails.Services.Count > 0)
                                        {
                                            <div class="grid sm:grid-cols-2 gap-4">
                                                @foreach (ServiceDto svc in associateDetails.Services)
                                                {
                                                    <div
                                                        class="rounded-lg border border-accent-800/30 p-3 bg-primary-900/50 flex gap-3">
                                                        <img
                                                            src="@(string.IsNullOrWhiteSpace(svc.ImageUrl) ? null : svc.ImageUrl)"
                                                            alt="svc"
                                                            class="w-24 h-16 object-cover rounded-md bg-primary-900/30"/>
                                                        <div class="flex-1">
                                                            <div class="font-semibold">@svc.Name</div>
                                                            <div
                                                                class="text-xs text-text-muted">@svc.Category • @svc.Price.ToString("F2")</div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @* Add service form *@
                                        <div class="mt-4 rounded-lg border border-accent-800/40 p-4 bg-primary-900/60">
                                            <h5 class="font-semibold mb-2">Add service</h5>
                                            <div class="grid sm:grid-cols-2 gap-3">
                                                <input @bind="newService.Name" placeholder="Service name"
                                                       maxlength="100"
                                                       class="w-full rounded-lg bg-primary-950 border border-accent-800/70 px-3 py-2 text-text-default"/>
                                                <input @bind="newService.Category" placeholder="Category" maxlength="50"
                                                       class="w-full rounded-lg bg-primary-950 border border-accent-800/70 px-3 py-2 text-text-default"/>
                                                <input @bind="newService.PriceString" placeholder="Price (e.g. 9.99)"
                                                       class="w-full rounded-lg bg-primary-950 border border-accent-800/70 px-3 py-2 text-text-default"/>
                                                <input @bind="newService.PriceSuffix"
                                                       placeholder="Price suffix (optional)" maxlength="20"
                                                       class="w-full rounded-lg bg-primary-950 border border-accent-800/70 px-3 py-2 text-text-default"/>
                                            </div>

                                            <div class="mt-3">
                                                <textarea @bind="newService.Description" rows="3"
                                                          placeholder="Short description"
                                                          class="w-full rounded-lg bg-primary-950 border border-accent-800/70 px-3 py-2 text-text-default"></textarea>
                                            </div>

                                            <div class="mt-3 flex items-center gap-3">
                                                <InputFile OnChange="OnNewServiceImageSelected"
                                                           accept="image/png,image/jpeg"
                                                           class="block text-sm text-text-default file:mr-4 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-accent-700 file:text-white hover:file:bg-accent-600"/>
                                                @if (!string.IsNullOrWhiteSpace(newService.ImageDataUrl))
                                                {
                                                    <img src="@newService.ImageDataUrl" alt="preview"
                                                         class="w-24 h-16 object-cover rounded-md"/>
                                                }
                                                <button @onclick="AddService"
                                                        class="px-4 py-2 rounded-lg font-semibold bg-accent-600 hover:bg-accent-700 text-white transition-colors">
                                                    Add Service
                                                </button>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(serviceErrorMessage))
                                            {
                                                <p class="text-sm text-red-300 mt-2">@serviceErrorMessage</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </section>
                            break;
                        case ProfileType.Anon:
                            <section class="rounded-2xl border border-accent-700/50 bg-primary-900/60 p-6">
                                <h3 class="text-2xl font-bold text-text-default">Anon Profile</h3>
                                <p class="text-text-muted mt-2">This profile keeps identity minimal. A generated
                                    anonymous handle is shown below.</p>
                                <div
                                    class="mt-4 inline-flex items-center rounded-lg bg-primary-950/60 border border-accent-900/50 px-4 py-2">
                                    <span class="text-text-muted mr-2">Handle:</span>
                                    <span class="font-semibold text-text-default">@selectedProfile.DisplayName</span>
                                </div>
                            </section>
                            break;
                    }
                }

                <section class="rounded-2xl border border-accent-800/40 bg-primary-950/40 p-6">
                    <h3 class="text-lg font-bold text-text-default">Account Session</h3>
                    <div class="mt-4 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        <div>
                            <p class="text-xs text-text-muted">Username</p>
                            <p class="text-text-default break-all">@username</p>
                        </div>
                        <div>
                            <p class="text-xs text-text-muted">Email</p>
                            <p class="text-text-default break-all">@email</p>
                        </div>
                        <div>
                            <p class="text-xs text-text-muted">User Id</p>
                            <p class="text-text-default break-all">@userId</p>
                        </div>
                        <div>
                            <p class="text-xs text-text-muted">Authentication</p>
                            <p class="text-text-default">@authenticationType</p>
                        </div>
                    </div>
                </section>
            </div>
        }
    </div>
</div>

@code {
    private const string UnknownValue = "Not available";

    private bool isLoading = true;
    private string? errorMessage;
    private string? createErrorMessage;

    private string username = UnknownValue;
    private string email = UnknownValue;
    private string userId = UnknownValue;
    private string authenticationType = UnknownValue;
    private string? accessToken;
    private Guid currentUserId;

    private List<UserProfileCard> profiles = new();
    private UserProfileCard? selectedProfile;

    private bool showCreatePanel;
    private List<ProfileType> availableTypes = new();
    private ProfileType newProfileType;
    private string newDisplayName = string.Empty;
    private string? newCustomerImageDataUrl;
    private string? customerImageErrorMessage;
    private string? pendingExistingCustomerImageDataUrl;
    private string? updateImageErrorMessage;
    private string? updateImageSuccessMessage;
    private bool isUpdatingImage;

    private const long CustomerImageMaxSizeBytes = 2 * 1024 * 1024;

    private bool CanAddProfile => availableTypes.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            AuthenticationState authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            ClaimsPrincipal user = authState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                string returnUrl = Uri.EscapeDataString("/profile");
                NavigationManager.NavigateTo($"/login?ReturnUrl={returnUrl}", true);
                return;
            }

            username = GetClaimValue(
                user,
                ClaimTypes.Name,
                JwtRegisteredClaimNames.UniqueName,
                "unique_name");

            email = GetClaimValue(
                user,
                ClaimTypes.Email,
                JwtRegisteredClaimNames.Email,
                "email");

            userId = GetClaimValue(
                user,
                ClaimTypes.NameIdentifier,
                JwtRegisteredClaimNames.Sub,
                "sub");

            if (!Guid.TryParse(userId, out currentUserId))
            {
                errorMessage = "Could not determine your user id.";
                return;
            }

            authenticationType = user.Identity.AuthenticationType ?? UnknownValue;
            accessToken = user.FindFirst("access_token")?.Value;

            await LoadProfilesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"An unexpected error occurred while loading your profile: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetClaimValue(ClaimsPrincipal principal, params string[] claimTypes)
    {
        foreach (string claimType in claimTypes)
        {
            string? claimValue = principal.FindFirst(claimType)?.Value;
            if (!string.IsNullOrWhiteSpace(claimValue))
            {
                return claimValue;
            }
        }

        return UnknownValue;
    }

    private static string BuildInitials(string value)
    {
        if (string.IsNullOrWhiteSpace(value) || value == UnknownValue)
        {
            return "?";
        }

        string[] parts = value.Split([' ', '.', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return value[..1].ToUpperInvariant();
        }

        if (parts.Length == 1)
        {
            return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        }

        return string.Concat(parts[0][0], parts[1][0]).ToUpperInvariant();
    }

    private static string GetTypeLabel(ProfileType type)
    {
        return type switch
        {
            ProfileType.Customer => "Customer",
            ProfileType.Associate => "Associate",
            ProfileType.Anon => "Anon",
            _ => type.ToString(),
        };
    }

    private static bool RequiresDisplayName(ProfileType type)
    {
        return type is ProfileType.Customer or ProfileType.Associate;
    }

    private void SelectProfile(ProfileType type)
    {
        selectedProfile = profiles.FirstOrDefault(p => p.Type == type);
        if (selectedProfile is not null && selectedProfile.Type == ProfileType.Associate)
        {
            _ = LoadAssociateDetailsAsync(selectedProfile.ProfileId);
        }
    }

    private void OpenCreatePanel()
    {
        createErrorMessage = null;
        customerImageErrorMessage = null;
        availableTypes = GetMissingTypes(profiles);
        if (availableTypes.Count == 0)
        {
            return;
        }

        newProfileType = availableTypes[0];
        newDisplayName = string.Empty;
        newCustomerImageDataUrl = null;
        pendingExistingCustomerImageDataUrl = null;
        updateImageErrorMessage = null;
        updateImageSuccessMessage = null;
        showCreatePanel = true;
    }

    private void CloseCreatePanel()
    {
        showCreatePanel = false;
        createErrorMessage = null;
        customerImageErrorMessage = null;
