    private async Task AddService()
    {
        serviceErrorMessage = null;

        if (selectedProfile is null || selectedProfile.Type != ProfileType.Associate)
        {
            serviceErrorMessage = "Select an associate profile first.";
            return;
        }

        int currentCount = associateDetails?.Services?.Count ?? 0;
        if (currentCount >= 255)
        {
            serviceErrorMessage = "Maximum number of services (255) reached.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newService.Name))
        {
            serviceErrorMessage = "Service name is required.";
            return;
        }

        if (!decimal.TryParse(newService.PriceString, out decimal price))
        {
            price = 0m;
        }

        var payload = new
        {
            UserId = currentUserId,
            selectedProfile.ProfileId,
            Name = newService.Name.Trim(),
            Description = newService.Description?.Trim(),
            Category = newService.Category?.Trim(),
            Price = price,
            PriceSuffix = newService.PriceSuffix?.Trim(),
            newService.ImageDataUrl,
        };

        try
        {
            HttpClient writeApi = CreateWriteApiClient();
            HttpResponseMessage response = await writeApi.PostAsJsonAsync($"api/v1/users/{currentUserId}/profiles/{selectedProfile.ProfileId}/services", payload);

            if (!response.IsSuccessStatusCode)
            {
                string responseText = await response.Content.ReadAsStringAsync();
                serviceErrorMessage = ExtractErrorMessage(response.StatusCode, responseText);
                return;
            }

            // reload services
            await LoadAssociateDetailsAsync(selectedProfile.ProfileId);

            // clear form
            newService = new ServiceCreateModel();
        }
        catch (Exception ex)
        {
            serviceErrorMessage = ex.Message;
        }
    }

