@inject SidebarStateService SidebarStateService
@implements IDisposable
@rendermode InteractiveServer

@*
    From lg the sidebar is a column next to the page (open by default, toggled by IsSidebarOpen). Below lg it is closed
    by default and slides in over the page (IsMobileSidebarOpen), so it never squeezes the content on phones (UI-001).
*@
@if (SidebarStateService.IsMobileSidebarOpen)
{
    <button type="button" aria-label="Zavřít postranní panel" tabindex="-1" @onclick="SidebarStateService.CloseMobileSidebar"
            class="lg:hidden fixed inset-0 top-16 z-20 w-full cursor-default bg-black/50"></button>
}

<aside
    class="@AsideClass">
    <div class="flex flex-col gap-2 overflow-hidden">
        @switch (SidebarStateService.SelectedPage)
        {
            case "Home":
                <span class="px-3 pt-2 pb-1 text-xs font-bold text-text-muted uppercase tracking-wider">Pracovní plocha</span>
                <NavLink href="dashboard"
                         class="px-3 py-2 rounded-md text-sm font-medium text-text-muted hover:bg-accent-800/50 hover:text-text-default transition-colors whitespace-nowrap"
                         activeClass="text-text-default bg-accent-800/50">Přehled
                </NavLink>
                <NavLink href="analytics"
                         class="px-3 py-2 rounded-md text-sm font-medium text-text-muted hover:bg-accent-800/50 hover:text-text-default transition-colors whitespace-nowrap"
                         activeClass="text-text-default bg-accent-800/50">Statistiky
                </NavLink>
                <NavLink href="settings"
                         class="px-3 py-2 rounded-md text-sm font-medium text-text-muted hover:bg-accent-800/50 hover:text-text-default transition-colors whitespace-nowrap"
                         activeClass="text-text-default bg-accent-800/50">Nastavení
                </NavLink>
                break;
            case "People":
                <span class="px-3 pt-2 pb-1 text-xs font-bold text-text-muted uppercase tracking-wider">Hráči</span>
                <NavLink href="people/all"
                         class="px-3 py-2 rounded-md text-sm font-medium text-text-muted hover:bg-accent-800/50 hover:text-text-default transition-colors whitespace-nowrap"
                         activeClass="text-text-default bg-accent-800/50">Všichni hráči
                </NavLink>
                <NavLink href="people/add"
                         class="px-3 py-2 rounded-md text-sm font-medium text-text-muted hover:bg-accent-800/50 hover:text-text-default transition-colors whitespace-nowrap"
                         activeClass="text-text-default bg-accent-800/50">Přidat hráče
                </NavLink>
                break;
            case "Services":
                <span class="px-3 pt-2 pb-1 text-xs font-bold text-text-muted uppercase tracking-wider">Služby</span>
                <NavLink href="services"
                         class="px-3 py-2 rounded-md text-sm font-medium text-text-muted hover:bg-accent-800/50 hover:text-text-default transition-colors whitespace-nowrap"
                         activeClass="text-text-default bg-accent-800/50">Všechny služby
                </NavLink>
                break;
            case "Orders":
                <span class="px-3 pt-2 pb-1 text-xs font-bold text-text-muted uppercase tracking-wider">Objednávky</span>
                <NavLink href="orders" Match="NavLinkMatch.All"
                         class="px-3 py-2 rounded-md text-sm font-medium text-text-muted hover:bg-accent-800/50 hover:text-text-default transition-colors whitespace-nowrap"
                         activeClass="text-text-default bg-accent-800/50">Moje objednávky
                </NavLink>
                <NavLink href="orders/incoming"
                         class="px-3 py-2 rounded-md text-sm font-medium text-text-muted hover:bg-accent-800/50 hover:text-text-default transition-colors whitespace-nowrap"
                         activeClass="text-text-default bg-accent-800/50">Objednávky mých služeb
                </NavLink>
                break;
            case "Wallets":
                <span class="px-3 pt-2 pb-1 text-xs font-bold text-text-muted uppercase tracking-wider">Peněženka</span>
                <NavLink href="wallet"
                         class="px-3 py-2 rounded-md text-sm font-medium text-text-muted hover:bg-accent-800/50 hover:text-text-default transition-colors whitespace-nowrap"
                         activeClass="text-text-default bg-accent-800/50">Zůstatek a historie
                </NavLink>
                break;
            case "Profile":
                <span class="px-3 pt-2 pb-1 text-xs font-bold text-text-muted uppercase tracking-wider">Profil</span>
                <NavLink href="profile"
                         class="px-3 py-2 rounded-md text-sm font-medium text-text-muted hover:bg-accent-800/50 hover:text-text-default transition-colors whitespace-nowrap"
                         activeClass="text-text-default bg-accent-800/50">Zobrazit profil
                </NavLink>
                break;
        }
    </div>
</aside>

@code {
    private string AsideClass
    {
        get
        {
            string mobile = SidebarStateService.IsMobileSidebarOpen
                ? "fixed top-16 bottom-0 left-0 z-30 w-64 p-4 overflow-y-auto bg-primary-950 shadow-2xl shadow-black/60"
                : "hidden";
            string desktop = SidebarStateService.IsSidebarOpen
                ? "lg:static lg:z-auto lg:block lg:w-56 lg:p-4 lg:bg-transparent lg:shadow-none"
                : "lg:static lg:z-auto lg:block lg:w-0 lg:p-0 lg:bg-transparent lg:shadow-none";
            return $"shrink-0 border-r border-accent-800/50 transition-all duration-300 ease-in-out {mobile} {desktop}";
        }
    }

    protected override void OnInitialized()
    {
        SidebarStateService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        SidebarStateService.OnChange -= StateHasChanged;
    }

}
