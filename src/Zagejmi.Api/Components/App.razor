<!DOCTYPE html>
<html lang="cs">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <link rel="stylesheet" href="@Assets["styles.css"]"/>
    <ImportMap/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    @* Same render mode as Routes: <PageTitle>/<HeadContent> inside interactive pages are sections, and sections
       cannot reach an outlet across a render mode boundary (the page title would never show). *@
    <HeadOutlet @rendermode="InteractiveServer"/>
</head>

<body class="w-full h-fit">
<Routes @rendermode="InteractiveServer"/>
<script src="_framework/blazor.web.js"></script>
</body>

</html>