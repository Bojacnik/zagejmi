@* 
    ServiceCard Component
    Displays a single service offering with image, details, rating, and action buttons.
    Inspired by Twitch service listings - shows service image, rating, served count, price, and promo tag.
*@

<div
    class="group rounded-xl overflow-hidden border border-accent-800/40 bg-primary-950/60 shadow-lg hover:shadow-accent-700/30 transition-all duration-300 hover:border-accent-600/60">
    @* Service Image with Overlay *@
    <div class="relative aspect-video overflow-hidden bg-primary-900">
        @if (!string.IsNullOrWhiteSpace(Service.ImageUrl))
        {
            <img src="@Service.ImageUrl" alt="@Service.Name"
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"/>
        }
        else
        {
            <div
                class="w-full h-full bg-gradient-to-br from-accent-700/40 to-accent-900/20 flex items-center justify-center">
                <span class="text-accent-400/60 text-sm">Bez obrázku</span>
            </div>
        }

        @* Promo Tag (if available) *@
        @if (!string.IsNullOrWhiteSpace(Service.PromoTag))
        {
            <div class="absolute top-2 right-2">
                <span
                    class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-accent-600 text-white shadow-lg">
                    ⚡ @Service.PromoTag
                </span>
            </div>
        }

        @* Availability Badge *@
        @if (!Service.IsAvailable)
        {
            <div class="absolute inset-0 bg-black/60 flex items-center justify-center">
                <span class="text-white font-semibold">Nedostupné</span>
            </div>
        }
    </div>

    @* Service Details *@
    <div class="p-4">
        @* Category Badge *@
        @if (!string.IsNullOrWhiteSpace(Service.Category))
        {
            <div
                class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-primary-900/80 border border-accent-800/50 text-accent-300 mb-2">
                @Service.Category
            </div>
        }

        @* Service Name *@
        <h3 class="text-lg font-bold text-text-default line-clamp-2 mb-1">@Service.Name</h3>

        @* Rating and Served Count *@
        <div class="flex items-center gap-3 mb-3">
            <div class="flex items-center gap-1">
                <span class="text-amber-400">⭐</span>
                <span class="font-bold text-text-default">@Service.Rating.ToString("F1")</span>
                <span class="text-xs text-text-muted">· @Service.Served× odehráno</span>
            </div>
        </div>

        @* Service Description *@
        <p class="text-sm text-text-muted line-clamp-2 mb-4">@Service.Description</p>

        @* Pricing Section *@
        <div class="flex items-center justify-between mb-4 pb-4 border-b border-accent-800/40">
            <div class="flex items-baseline gap-1">
                <span class="text-2xl font-bold text-accent-300">@Service.Price.ToString("F2")</span>
                @if (!string.IsNullOrWhiteSpace(Service.PriceSuffix))
                {
                    <span class="text-sm text-text-muted">@Service.PriceSuffix</span>
                }
                else
                {
                    <span class="text-sm text-text-muted">/ služba</span>
                }
            </div>

            @* Response Time *@
            @if (!string.IsNullOrWhiteSpace(Service.ResponseTime))
            {
                <div class="flex items-center gap-1 text-xs text-text-muted">
                    <span>⏱️</span>
                    <span>Průměrná odpověď: @Service.ResponseTime</span>
                </div>
            }
        </div>

        @* Action Buttons *@
        <div class="flex gap-2">
            <button disabled="@(!Service.IsAvailable)"
                    class="flex-1 px-4 py-2 rounded-lg font-semibold text-white transition-colors
                           @(Service.IsAvailable ? "bg-primary-800 hover:bg-primary-700 cursor-pointer" : "bg-primary-950/60 text-text-muted cursor-not-allowed opacity-50")">
                Napsat
            </button>
            <button disabled="@(!Service.IsAvailable)"
                    class="flex-1 px-4 py-2 rounded-lg font-semibold text-white bg-accent-600 transition-colors
                           @(Service.IsAvailable ? "hover:bg-accent-700 cursor-pointer" : "opacity-50 cursor-not-allowed")">
                Objednat
            </button>
        </div>
    </div>
</div>

@code {

    /// <summary>
    ///     The service data to display.
    /// </summary>
    [Parameter]
    public ServiceDto Service { get; set; } = null!;

}

