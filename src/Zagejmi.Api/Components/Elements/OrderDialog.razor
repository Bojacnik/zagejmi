@using System.Security.Claims
@using System.Threading
@using Zagejmi.Api.Localization
@using Microsoft.Extensions.Options
@using Zagejmi.Application.Orders
@using Zagejmi.Application.Orders.PlaceOrder
@using Zagejmi.Application.Wallets.GetWallet
@using Zagejmi.Domain.Orders
@using Zagejmi.Domain.Profiles
@using Zagejmi.Shared
@implements IDisposable
@inject PlaceOrderHandler PlaceOrderHandler
@inject GetWalletHandler GetWalletHandler
@inject WalletStateService Wallet
@inject IOptions<OrderOptions> OrderSettings

@*
    Order confirmation (ORDER-001): quantity 1–10, total, the customer's balance. Paying moves the total into escrow;
    the player has 48 h to accept. Always paid from the Zákazník wallet, whichever profile is active.
*@

<div class="fixed inset-0 z-[60] flex items-center justify-center p-4" role="dialog" aria-modal="true"
     aria-labelledby="order-dialog-title" @onkeydown="OnKeyDown" @onkeydown:stopPropagation tabindex="-1" @ref="dialog">
    <div class="absolute inset-0 bg-black/70" @onclick="Close"></div>

    <div class="relative w-full max-w-md rounded-2xl border border-accent-700/50 bg-primary-950 p-6 shadow-2xl shadow-black/60 modal-pop-in">
        @if (placedOrderId is not null)
        {
            <h2 id="order-dialog-title" class="text-xl font-bold text-text-default">Objednáno!</h2>
            <p class="mt-3 text-text-default/90">
                @CzechLabels.Goins(Total) je bezpečně uložených, dokud služba neproběhne. Hráč má
                @AcceptHours hodin na přijetí, jinak vám vše vrátíme.
            </p>
            <div class="mt-6 flex justify-end gap-3">
                <button type="button" @onclick="Close" class="px-4 py-2 rounded-lg text-text-muted hover:text-text-default">Zavřít</button>
                <a href="/orders" class="px-4 py-2 rounded-lg bg-accent-600 text-white font-semibold hover:bg-accent-500">Moje objednávky</a>
            </div>
        }
        else
        {
            <h2 id="order-dialog-title" class="text-xl font-bold text-text-default">Objednat službu</h2>
            <p class="mt-1 text-text-muted">@ServiceName</p>

            <div class="mt-5 flex items-center justify-between gap-4">
                <label for="order-quantity" class="text-sm text-text-default">
                    Počet @(string.IsNullOrWhiteSpace(PriceUnit) ? "" : $"({PriceUnit.Trim().TrimStart('/').Trim()})")
                </label>
                <div class="flex items-center gap-2">
                    <button type="button" aria-label="Méně" disabled="@(quantity <= 1)" @onclick="() => quantity--"
                            class="w-9 h-9 rounded-lg border border-accent-800/70 text-text-default disabled:opacity-40">−</button>
                    <input id="order-quantity" type="number" min="1" max="@Order.MaxQuantity" @bind="Quantity"
                           class="w-14 text-center rounded-lg bg-primary-900 border border-accent-800/70 py-1.5 text-text-default"/>
                    <button type="button" aria-label="Více" disabled="@(quantity >= Order.MaxQuantity)" @onclick="() => quantity++"
                            class="w-9 h-9 rounded-lg border border-accent-800/70 text-text-default disabled:opacity-40">+</button>
                </div>
            </div>

            <dl class="mt-5 space-y-1 text-sm">
                <div class="flex justify-between">
                    <dt class="text-text-muted">Cena za kus</dt>
                    <dd class="text-text-default">@CzechLabels.Goins(UnitPrice)</dd>
                </div>
                <div class="flex justify-between text-base font-bold">
                    <dt class="text-text-default">Celkem</dt>
                    <dd class="text-accent-300">@CzechLabels.Goins(Total)</dd>
                </div>
                @if (wallet is not null)
                {
                    <div class="flex justify-between pt-2">
                        <dt class="text-text-muted">V peněžence máte</dt>
                        <dd class="@(wallet.Balance < Total ? "text-red-300" : "text-text-default")">
                            @CzechLabels.Goins(wallet.Balance)
                            @if (wallet.BonusBalance > 0)
                            {
                                <span class="text-text-muted">&nbsp;(z toho bonus @CzechLabels.Goins(wallet.BonusBalance), použije se jako první)</span>
                            }
                        </dd>
                    </div>
                }
            </dl>

            <p class="mt-4 text-xs text-text-muted">
                Goiny se uloží stranou. Hráč dostane zaplaceno, až službu potvrdíte (nebo @ConfirmHours hodin po jejím
                skončení). Dokud hráč objednávku nepřijme, můžete ji zrušit a dostanete vše zpět.
            </p>

            @if (errorMessage is not null)
            {
                <p class="mt-4 text-sm text-red-300" role="alert">@errorMessage</p>
            }

            <div class="mt-6 flex justify-end gap-3">
                <button type="button" @onclick="Close" class="px-4 py-2 rounded-lg text-text-muted hover:text-text-default">Zpět</button>
                <button type="button" @onclick="PlaceAsync" disabled="@(isPlacing || wallet is null || wallet.Balance < Total)"
                        class="px-4 py-2 rounded-lg bg-accent-600 text-white font-semibold hover:bg-accent-500 disabled:opacity-50 disabled:cursor-not-allowed">
                    @(isPlacing ? "Objednáváme…" : $"Zaplatit {CzechLabels.Goins(Total)}")
                </button>
            </div>
            @if (wallet is not null && wallet.Balance < Total)
            {
                <p class="mt-3 text-right text-sm"><a href="/wallet" class="text-accent-300 hover:underline">Doplnit peněženku</a></p>
            }
        }
    </div>
</div>

@code {
    private readonly CancellationTokenSource disposed = new();
    private ElementReference dialog;
    private int quantity = 1;
    private Guid? userId;
    private WalletView? wallet;
    private bool isPlacing;
    private string? errorMessage;
    private Guid? placedOrderId;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>Gets or sets the service to order.</summary>
    [Parameter, EditorRequired]
    public Guid ServiceId { get; set; }

    /// <summary>Gets or sets the service name.</summary>
    [Parameter, EditorRequired]
    public string ServiceName { get; set; } = string.Empty;

    /// <summary>Gets or sets the price of one unit.</summary>
    [Parameter, EditorRequired]
    public long UnitPrice { get; set; }

    /// <summary>Gets or sets the price unit, if any.</summary>
    [Parameter]
    public string? PriceUnit { get; set; }

    /// <summary>Gets or sets the callback invoked when the dialog closes.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private long Total => UnitPrice * quantity;

    private int AcceptHours => (int)OrderSettings.Value.AcceptWindow.TotalHours;

    private int ConfirmHours => (int)OrderSettings.Value.ConfirmWindow.TotalHours;

    private int Quantity
    {
        get => quantity;
        set => quantity = Math.Clamp(value, 1, Order.MaxQuantity);
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is null)
        {
            return;
        }

        ClaimsPrincipal user = (await AuthenticationState).User;
        string? claim = user.FindFirstValue(ClaimTypes.NameIdentifier) ?? user.FindFirstValue("sub");
        if (!Guid.TryParse(claim, out Guid id))
        {
            errorMessage = "Pro objednání se nejdříve přihlaste.";
            return;
        }

        userId = id;
        Result<WalletView> result = await GetWalletHandler.Handle(new GetWalletQuery(id, ProfileType.Customer), disposed.Token);
        wallet = result.IsSuccess ? result.Value : null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await dialog.FocusAsync();
        }
    }

    private async Task PlaceAsync()
    {
        if (userId is not { } id)
        {
            return;
        }

        isPlacing = true;
        errorMessage = null;
        try
        {
            Result<Guid> result = await PlaceOrderHandler.Handle(new PlaceOrderCommand(id, ServiceId, quantity), disposed.Token);
            if (result.IsFailure)
            {
                errorMessage = result.Error!.Message;
                return;
            }

            placedOrderId = result.Value;
            await Wallet.RefreshAsync();
        }
        catch (OperationCanceledException)
        {
            // The dialog was closed while ordering.
        }
        finally
        {
            isPlacing = false;
        }
    }

    private Task Close() => OnClose.InvokeAsync();

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;

    public void Dispose()
    {
        disposed.Cancel();
        disposed.Dispose();
    }
}
