@inject NavigationManager NavigationManager

@code {
    private bool hasNavigated;

    /// <summary>
    ///     The same authentication state AuthorizeRouteView decided on (cascaded, so it follows sign-in and sign-out).
    /// </summary>
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || hasNavigated)
        {
            return;
        }

        if (AuthenticationState is not null && (await AuthenticationState).User.Identity?.IsAuthenticated == true)
        {
            return;
        }

        string relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        string returnUrl = Uri.EscapeDataString($"/{relativePath}");
        hasNavigated = true;
        NavigationManager.NavigateTo($"/login?ReturnUrl={returnUrl}", true);
    }

}