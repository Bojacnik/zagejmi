@page "/login"
@using System.Text.Json
@using Zagejmi.Shared.Models
@rendermode InteractiveServer
@inject NavigationManager NavManager
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="w-full h-full flex flex-col justify-center items-center p-4">
    <form @onsubmit="HandleLoginAsync" @onsubmit:preventDefault novalidate
          class="w-full max-w-sm p-8 space-y-6 bg-primary-900 rounded-xl border border-accent-700/50 shadow-2xl shadow-accent-900/30">

        <header class="text-center">
            <h1 class="text-4xl font-bold text-gray-100">Welcome Back</h1>
            <p class="text-gray-400 mt-2">Please enter your credentials to login.</p>
        </header>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="p-4 text-sm text-red-400 bg-red-900/30 border border-red-400/50 rounded-lg" role="alert">
                <p>@ErrorMessage</p>
            </div>
        }

        @if (!string.IsNullOrEmpty(resendMessage))
        {
            <div class="p-4 text-sm text-green-400 bg-green-900/30 border border-green-400/50 rounded-lg" role="status">
                <p>@resendMessage</p>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(registeredMessage))
        {
            <div class="p-4 text-sm text-green-400 bg-green-900/30 border border-green-400/50 rounded-lg" role="status">
                <p>@registeredMessage</p>
            </div>
        }

        <div class="space-y-4">
            <div>
                <label for="useridentifier" class="sr-only">Username or Email</label>
                <input @bind="userIdentifier" type="text" id="useridentifier"
                       placeholder="Username or Email" required
                       class="w-full px-4 py-3 bg-gray-200 border-2 border-gray-300 rounded-lg text-black placeholder:text-gray-500 focus:ring-2 focus:ring-accent-500 focus:border-accent-500 outline-none transition-all"/>
            </div>

            <div>
                <label for="password" class="sr-only">Password</label>
                <input @bind="password" type="password" id="password" placeholder="Password" required
                       class="w-full px-4 py-3 bg-gray-200 border-2 border-gray-300 rounded-lg text-black placeholder:text-gray-500 focus:ring-2 focus:ring-accent-500 focus:border-accent-500 outline-none transition-all"/>
            </div>
        </div>

        <div class="flex flex-col gap-4 pt-4">
            <button type="submit"
                    disabled="@isSubmitting"
                    class="w-full px-4 py-3 font-bold text-lg text-white bg-accent-600 hover:bg-accent-700 rounded-lg transition-colors shadow-lg shadow-accent-800/40 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-primary-900 focus:ring-accent-500 disabled:opacity-50 disabled:cursor-not-allowed">
                <span>@(isSubmitting ? "Logging in..." : "Login")</span>
            </button>
            <button type="button"
                    @onclick="ResendVerificationEmail"
                    disabled="@isResending || string.IsNullOrWhiteSpace(userIdentifier)"
                    class="w-full px-4 py-3 font-semibold text-white bg-primary-700 hover:bg-primary-600 rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                @if (isResending)
                {
                    <span>Sending verification email...</span>
                }
                else if (showResendVerification)
                {
                    <span>Resend verification email (account not verified)</span>
                }
                else
                {
                    <span>Resend verification email</span>
                }
            </button>
            <div class="text-center">
                <a href="/register"
                   class="text-sm font-medium text-accent-400 hover:text-accent-300 hover:underline transition-colors">
                    Don't have an account? Register
                </a>
            </div>
        </div>
    </form>
</div>

@code {

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "registered")]
    private int? Registered { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    private string? RegisteredEmail { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorMessage { get; set; }

    private string userIdentifier = string.Empty;
    private string password = string.Empty;
    private string normalizedReturnUrl = "/";
    private bool showResendVerification;
    private bool isResending;
    private bool isSubmitting;
    private string resendMessage = string.Empty;
    private string? registeredMessage;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl)
            && Uri.TryCreate(ReturnUrl, UriKind.Relative, out _)
            && ReturnUrl.StartsWith("/", StringComparison.Ordinal)
            && !ReturnUrl.StartsWith("//", StringComparison.Ordinal))
        {
            normalizedReturnUrl = ReturnUrl;
        }

        showResendVerification = !string.IsNullOrWhiteSpace(ErrorMessage)
                                 && ErrorMessage.Contains("not verified", StringComparison.OrdinalIgnoreCase);

        if (Registered != 1) return;

        registeredMessage = "Account created. Verify your email, then sign in.";
        if (!string.IsNullOrWhiteSpace(RegisteredEmail))
        {
            userIdentifier = RegisteredEmail.Trim();
        }
    }

    private async Task ResendVerificationEmail()
    {
        if (string.IsNullOrWhiteSpace(userIdentifier) || isResending)
        {
            return;
        }

        isResending = true;
        resendMessage = string.Empty;

        try
        {
            HttpClient client = HttpClientFactory.CreateClient("WriteAPI");
            HttpResponseMessage response = await client.PostAsJsonAsync(
                "api/v1/auth/verify-email/send",
                new { UserIdentifier = userIdentifier });

            if (response.IsSuccessStatusCode)
            {
                resendMessage = "Verification email sent. Please check your inbox.";
                return;
            }

            string error = await response.Content.ReadAsStringAsync();
            List<string> errors = TryParseErrors(error);
            ErrorMessage = errors.Count == 0 ? "Unable to resend verification email." : string.Join(", ", errors);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isResending = false;
        }
    }

    private async Task HandleLoginAsync()
    {
        if (isSubmitting)
        {
            return;
        }

        ErrorMessage = null;
        resendMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(userIdentifier) || string.IsNullOrWhiteSpace(password))
        {
            ErrorMessage = "Username/email and password are required.";
            return;
        }

        isSubmitting = true;

        try
        {
            HttpClient client = HttpClientFactory.CreateClient("WriteAPI");

            HttpResponseMessage response = await client.PostAsJsonAsync(
                "api/v1/auth/login",
                new
                {
                    UserIdentifier = userIdentifier,
                    Password = password
                });

            string body = await response.Content.ReadAsStringAsync();
            if (!response.IsSuccessStatusCode)
            {
                List<string> errors = TryParseErrors(body);
                ErrorMessage = errors.Count == 0 ? "Login failed." : string.Join(", ", errors);
                showResendVerification = ErrorMessage.Contains("not verified", StringComparison.OrdinalIgnoreCase);
                return;
            }

            LoginTokenResponse? tokenResponse = JsonSerializer.Deserialize<LoginTokenResponse>(body, JsonOptions);
            if (tokenResponse == null ||
                string.IsNullOrWhiteSpace(tokenResponse.AccessToken) ||
                string.IsNullOrWhiteSpace(tokenResponse.RefreshToken))
            {
                ErrorMessage = "Login response did not contain required tokens.";
                return;
            }

            if (AuthenticationStateProvider is JwtAuthenticationStateProvider jwtProvider)
            {
                await jwtProvider.SetTokensAsync(tokenResponse.AccessToken, tokenResponse.RefreshToken);
            }

            NavManager.NavigateTo(normalizedReturnUrl, true);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static List<string> TryParseErrors(string errorContent)
    {
        if (string.IsNullOrWhiteSpace(errorContent))
        {
            return [];
        }

        ValidationErrorResponse? errorResponse = JsonSerializer.Deserialize<ValidationErrorResponse>(errorContent, JsonOptions);
        if (errorResponse?.Errors.Count > 0)
        {
            return errorResponse.Errors;
        }

        JsonElement root = JsonSerializer.Deserialize<JsonElement>(errorContent);
        if (root.ValueKind != JsonValueKind.Object || !root.TryGetProperty("errors", out JsonElement errorsElement) ||
            errorsElement.ValueKind != JsonValueKind.Array) return [];
        List<string> errors = [];
        errors.AddRange(
            from item in errorsElement.EnumerateArray()
            where item.ValueKind == JsonValueKind.String
            select item.GetString()
            into value
            where !string.IsNullOrWhiteSpace(value)
            select value);

        return errors.Count > 0 ? errors : [];
    }

    private sealed class LoginTokenResponse
    {
        public string AccessToken { get; set; } = string.Empty;

        public string RefreshToken { get; set; } = string.Empty;
    }

}