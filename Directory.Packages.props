<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <!-- ASP.NET Core -->
        <PackageVersion Include="Microsoft.AspNetCore.App.Internal.Assets" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0"/>
        <!-- Entity Framework Core -->
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="11.0.0"/>
        <!-- Storage -->
        <PackageVersion Include="Minio" Version="7.0.0"/>
        <!-- Database provider. No stable 11.0 build yet; NU1608 (EF version constraint) is expected until it ships. -->
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3"/>
        <!-- Identity & Security -->
        <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0"/>
        <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0"/>
        <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.23.0"/>
        <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1"/>
        <!-- Hosting -->
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0"/>
        <!-- Image Processing -->
        <!-- Skia parses untrusted uploads in native code: keep these two current and in lockstep. -->
        <PackageVersion Include="SkiaSharp" Version="4.156.0"/>
        <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.156.0"/>
        <!-- API Documentation -->
        <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerGen" Version="11.0.1"/>
        <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1"/>
        <!-- Testing (runs on Microsoft.Testing.Platform, see global.json) -->
        <PackageVersion Include="xunit.v3" Version="4.0.3"/>
        <!-- Code Analysis -->
        <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180"/>
    </ItemGroup>
</Project>